# =============================================================================
# Treasurio — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------------------------
# PostgreSQL Connection
# -----------------------------------------------------------------------------

# Full connection string (takes precedence over individual vars when set)
# DATABASE_URL=postgres://treasurio:changeme@localhost:5432/treasurio

# Individual connection variables (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=treasurio
PGUSER=treasurio
PGPASSWORD=changeme

# Connection pool size (1–100, default: 10)
PG_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Application Server
# -----------------------------------------------------------------------------

# Port the app listens on inside the container (default: 3000)
PORT=3000

# Host port mapped by Docker Compose (default: 3100, binds to 127.0.0.1)
APP_PORT=3100

# Domain for nginx/reverse proxy configuration
DOMAIN=treasurio.example.com

# Set to production for secure cookies and mandatory session secret
NODE_ENV=development

# Set to 1 only when serving through HTTPS (behind nginx with TLS)
SECURE_COOKIES=0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Session secret (CHANGE IN PRODUCTION — use a long random string)
SESSION_SECRET=change-this-long-random-secret

# n8n API token for external integrations
N8N_API_TOKEN=change-this-n8n-token

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------

# Organization/group name displayed in the UI and reports
GROUP_NAME=My Group

# Currency code used for formatting monetary values (e.g., GHS, USD, EUR, GBP)
GROUP_CURRENCY=GHS
