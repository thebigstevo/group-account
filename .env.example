# Server
PORT=3000

# Database path (relative or absolute)
DB_PATH=./storage/accounts.db

# Session secret (CHANGE IN PRODUCTION - use a long random string)
SESSION_SECRET=change-this-long-random-secret

# n8n API token for external integrations
N8N_API_TOKEN=change-this-n8n-token

# Set to production for secure cookies and mandatory secret
NODE_ENV=development

# Set to 1 only when serving through HTTPS
SECURE_COOKIES=0
