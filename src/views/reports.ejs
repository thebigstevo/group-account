<%- include('partials/header') %>
<% locals.title = 'Reports' %>

<section class="page-title print-head">
  <div>
    <h1>Monthly executive report</h1>
    <p><%= period.label %>. Use browser print to save this report as PDF.</p>
  </div>
  <form method="get" action="/reports" class="inline-form no-print">
    <div class="form-group">
      <label for="report-year">Year</label>
      <input id="report-year" name="year" type="number" value="<%= year %>">
    </div>
    <div class="form-group">
      <label for="report-month">Month</label>
      <select id="report-month" name="month">
        <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(name, index) { %>
          <option value="<%= index + 1 %>" <%= month === index + 1 ? 'selected' : '' %>><%= name %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn btn--primary" type="submit">View month</button>
    <button class="btn btn--secondary" type="button" data-print>Print</button>
  </form>
  <div class="no-print" style="margin-top: 10px; text-align: right;">
    <a class="btn btn--secondary btn--sm" href="/export/report?year=<%= year %>&month=<%= month %>">Export CSV</a>
  </div>
</section>

<section class="metric-grid">
  <% summary.balances.forEach(function(account) { %>
    <div class="metric-card"><span class="metric-card__label"><%= account.name %> raw balance</span><strong class="metric-card__value"><%= formatMoney(account.balance) %></strong></div>
  <% }) %>
  <div class="metric-card"><span class="metric-card__label">Gross receipts this month</span><strong class="metric-card__value"><%= formatMoney(summary.grossReceipts) %></strong></div>
  <div class="metric-card"><span class="metric-card__label">Income this month</span><strong class="metric-card__value"><%= formatMoney(summary.income) %></strong></div>
  <div class="metric-card"><span class="metric-card__label">Spends this month</span><strong class="metric-card__value"><%= formatMoney(summary.expenses) %></strong></div>
  <div class="metric-card metric-card--warning"><span class="metric-card__label">Welfare liability</span><strong class="metric-card__value"><%= formatMoney(summary.welfareLiability) %></strong></div>
  <div class="metric-card"><span class="metric-card__label">Total raw balance</span><strong class="metric-card__value"><%= formatMoney(summary.totalCashPosition) %></strong></div>
  <div class="metric-card metric-card--warning"><span class="metric-card__label">Estimated spendable balance</span><strong class="metric-card__value"><%= formatMoney(summary.spendableBalance) %></strong></div>
</section>

<section class="grid two">
  <div class="panel">
    <h2>Raw vs reconciled balances</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Account</th><th class="num">Raw balance</th><th class="num">Last reconciled</th><th>Date</th><th class="num">Difference</th></tr></thead>
        <tbody>
          <% summary.balances.forEach(function(account) {
            const rec = reconciliations.find(function(item) { return item.account_id === account.id; });
          %>
            <tr>
              <td><%= account.name %></td>
              <td class="num"><%= formatMoney(account.balance) %></td>
              <td class="num"><%= rec && rec.statement_balance !== null ? formatMoney(rec.statement_balance) : 'Not reconciled' %></td>
              <td><%= rec && rec.period_end ? rec.period_end : '' %></td>
              <td class="num"><%= rec && rec.difference !== null ? formatMoney(rec.difference) : '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <h2>Period notes</h2>
    <div class="table-wrap">
      <table class="data-table">
        <tbody>
          <tr><th>Period start</th><td><%= period.startDate %></td></tr>
          <tr><th>Period end</th><td><%= period.endDate %></td></tr>
          <tr><th>Welfare collected this month</th><td class="num"><%= formatMoney(summary.welfareCollected) %></td></tr>
          <tr><th>Welfare still payable</th><td class="num"><%= formatMoney(summary.welfareLiability) %></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="grid two">
  <div class="panel">
    <h2>Income by category</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Category</th><th class="num">Amount</th></tr></thead>
        <tbody>
          <% incomeByCategory.forEach(function(row) { %><tr><td><%= row.category %></td><td class="num"><%= formatMoney(row.total) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <h2>Expenses by category</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Category</th><th class="num">Amount</th></tr></thead>
        <tbody>
          <% expensesByCategory.forEach(function(row) { %><tr><td><%= row.category %></td><td class="num"><%= formatMoney(row.total) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="panel">
  <h2>Running balance</h2>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Member / detail</th><th>Category</th><th class="num">Cash impact</th><th class="num">Running balance</th></tr></thead>
      <tbody>
        <% runningRows.forEach(function(row) { %>
          <tr>
            <td><%= row.tx_date %></td>
            <td><%= row.tx_type %></td>
            <td><%= row.tx_type === 'transfer' ? (row.account_name + ' to ' + row.to_account_name) : (row.account_name || '') %></td>
            <td><%= row.member_name || row.description || '' %></td>
            <td><%= row.category %></td>
            <td class="num"><%= formatMoney(row.cashImpact) %></td>
            <td class="num"><%= formatMoney(row.runningBalance) %></td>
          </tr>
        <% }) %>
        <% if (runningRows.length === 0) { %>
          <tr><td colspan="7">No transactions recorded for this month.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <h2>Member arrears for <%= year %></h2>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Member</th><th>Phone</th><th class="num">Opening</th><th class="num">Due</th><th class="num">Paid</th><th class="num">Balance</th></tr></thead>
      <tbody>
        <% arrears.filter(function(row) { return row.balance > 0; }).forEach(function(row) { %>
          <tr>
            <td><%= row.name %></td>
            <td><%= row.phone || '' %></td>
            <td class="num"><%= formatMoney(row.opening_arrears) %></td>
            <td class="num"><%= formatMoney(row.assessment_due) %></td>
            <td class="num"><%= formatMoney(row.paid) %></td>
            <td class="num"><%= formatMoney(row.balance) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
