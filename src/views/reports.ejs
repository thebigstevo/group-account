<%- include('partials/header') %>
<% locals.title = 'Reports' %>

<div class="page-container">
  <section class="page-title print-head">
    <div>
      <span class="eyebrow">Finance · Reports</span>
      <h1>Monthly executive report</h1>
      <p><%= period.label %>. Review the period position or use browser print to save a PDF.</p>
    </div>
    <a class="btn btn--secondary btn--sm no-print" href="/export/report?year=<%= year %>&month=<%= month %>">Export CSV</a>
  </section>

  <form method="get" action="/reports" class="report-toolbar no-print" aria-label="Report period">
    <div class="report-toolbar__fields">
      <div class="form-group">
        <label for="report-year">Year</label>
        <input id="report-year" name="year" type="number" value="<%= year %>">
      </div>
      <div class="form-group">
        <label for="report-month">Month</label>
        <select id="report-month" name="month">
          <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(name, index) { %>
            <option value="<%= index + 1 %>" <%= month === index + 1 ? 'selected' : '' %>><%= name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="report-toolbar__actions">
      <button class="btn btn--primary" type="submit">View month</button>
      <button class="btn btn--secondary" type="button" data-print>Print</button>
    </div>
  </form>

  <section class="summary-strip" aria-label="Period summary">
    <div class="summary-strip__item"><span class="summary-strip__label">Total raw balance</span><strong class="summary-strip__value"><%= formatMoney(summary.totalCashPosition) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Income this month</span><strong class="summary-strip__value"><%= formatMoney(summary.income) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Expenses this month</span><strong class="summary-strip__value"><%= formatMoney(summary.expenses) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Estimated spendable</span><strong class="summary-strip__value"><%= formatMoney(summary.spendableBalance) %></strong></div>
  </section>

  <section class="grid two report-grid">
    <div class="panel">
      <div class="section-head"><div><h2>Account balances</h2><p>Raw and last reconciled positions.</p></div></div>
      <div class="account-list">
        <% summary.balances.forEach(function(account) {
          const rec = reconciliations.find(function(item) { return item.account_id === account.id; });
        %>
          <div class="report-account-row">
            <div><strong><%= account.name %></strong><span><%= rec && rec.period_end ? 'Reconciled ' + rec.period_end : 'Not reconciled' %></span></div>
            <div><strong><%= formatMoney(account.balance) %></strong><span><%= rec && rec.difference !== null ? 'Difference ' + formatMoney(rec.difference) : 'Raw balance' %></span></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="panel">
      <div class="section-head"><div><h2>Period notes</h2><p>Key reporting context.</p></div></div>
      <dl class="report-notes">
        <div><dt>Period start</dt><dd><%= period.startDate %></dd></div>
        <div><dt>Period end</dt><dd><%= period.endDate %></dd></div>
        <div><dt>Gross receipts</dt><dd><%= formatMoney(summary.grossReceipts) %></dd></div>
        <div><dt>Welfare collected</dt><dd><%= formatMoney(summary.welfareCollected) %></dd></div>
        <div><dt>Welfare still payable</dt><dd><%= formatMoney(summary.welfareLiability) %></dd></div>
      </dl>
    </div>
  </section>

  <section class="grid two report-grid">
    <div class="panel">
      <h2>Income by category</h2>
      <div class="table-wrap"><table class="data-table"><thead><tr><th>Category</th><th class="num">Amount</th></tr></thead><tbody>
        <% incomeByCategory.forEach(function(row) { %><tr><td><%= row.category %></td><td class="num"><%= formatMoney(row.total) %></td></tr><% }) %>
        <% if (incomeByCategory.length === 0) { %><tr><td colspan="2">No income recorded for this month.</td></tr><% } %>
      </tbody></table></div>
    </div>
    <div class="panel">
      <h2>Expenses by category</h2>
      <div class="table-wrap"><table class="data-table"><thead><tr><th>Category</th><th class="num">Amount</th></tr></thead><tbody>
        <% expensesByCategory.forEach(function(row) { %><tr><td><%= row.category %></td><td class="num"><%= formatMoney(row.total) %></td></tr><% }) %>
        <% if (expensesByCategory.length === 0) { %><tr><td colspan="2">No expenses recorded for this month.</td></tr><% } %>
      </tbody></table></div>
    </div>
  </section>

  <section class="panel">
    <div class="section-head"><div><h2>Running balance</h2><p>Posted movements for the selected period.</p></div></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Member / detail</th><th>Category</th><th class="num">Cash impact</th><th class="num">Running balance</th></tr></thead><tbody>
      <% runningRows.forEach(function(row) { %><tr><td><%= row.tx_date %></td><td><%= row.tx_type %></td><td><%= row.tx_type === 'transfer' ? (row.account_name + ' to ' + row.to_account_name) : (row.account_name || '') %></td><td><%= row.member_name || row.description || '' %></td><td><%= row.category %></td><td class="num"><%= formatMoney(row.cashImpact) %></td><td class="num"><%= formatMoney(row.runningBalance) %></td></tr><% }) %>
      <% if (runningRows.length === 0) { %><tr><td colspan="7">No transactions recorded for this month.</td></tr><% } %>
    </tbody></table></div>
  </section>

  <section class="panel">
    <div class="section-head"><div><h2>Member arrears for <%= year %></h2><p>Members with an outstanding balance.</p></div></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Member</th><th>Phone</th><th class="num">Opening</th><th class="num">Due</th><th class="num">Paid</th><th class="num">Balance</th></tr></thead><tbody>
      <% arrears.filter(function(row) { return row.balance > 0; }).forEach(function(row) { %><tr><td><%= row.name %></td><td><%= row.phone || '' %></td><td class="num"><%= formatMoney(row.opening_arrears) %></td><td class="num"><%= formatMoney(row.assessment_due) %></td><td class="num"><%= formatMoney(row.paid) %></td><td class="num"><%= formatMoney(row.balance) %></td></tr><% }) %>
    </tbody></table></div>
  </section>
</div>
<%- include('partials/footer') %>
