<%- include('partials/header') %>
<section class="page-title">
  <div>
    <span class="eyebrow">Register</span>
    <h1>Members</h1>
    <p>Maintain contact details, status, opening arrears, and notes used for reports and SMS reminders.</p>
  </div>
  <div class="hero-actions">
    <a class="button secondary" href="/members/import">Import CSV / Excel</a>
    <input class="search-input" type="search" placeholder="Search members" data-table-search="members-table">
  </div>
</section>

<section class="grid two">
  <div class="panel">
    <div class="section-head">
      <div>
        <h2>Member list</h2>
        <p><%= members.length %> records in the register.</p>
      </div>
    </div>
    <div class="table-wrap">
      <table id="members-table">
        <thead><tr><th>Name</th><th>Phone</th><th>DOB</th><th>Status</th><th class="num">Opening arrears</th><th></th></tr></thead>
        <tbody>
          <% members.forEach((member) => { %>
            <tr>
              <td><strong><%= member.name %></strong></td>
              <td><%= member.phone || '' %></td>
              <td><%= member.dob || '' %></td>
              <td><span class="badge <%= member.status === 'active' ? 'success' : 'soft' %>"><%= member.status %></span></td>
              <td class="num"><%= formatMoney(member.opening_arrears) %></td>
              <td><a class="text-link" href="/members/<%= member.id %>/edit">Edit</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <h2>Add member</h2>
    <form method="post" action="/members" class="stack">
      <%- include('partials/csrf') %>
      <label>Name <input name="name" required></label>
      <label>Phone <input name="phone"></label>
      <label>Date of birth <input name="dob" type="date"></label>
      <label>Status
        <select name="status">
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </label>
      <label>Opening arrears <input name="opening_arrears" type="number" step="0.01" value="0"></label>
      <label>Notes <textarea name="notes"></textarea></label>
      <button type="submit">Add member</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
