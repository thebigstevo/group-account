<%- include('partials/header') %>
<% locals.title = 'Members' %>

<section class="page-title">
  <div>
    <span class="eyebrow">Register</span>
    <h1>Members</h1>
    <p>Maintain contact details, status, opening arrears, and notes used for reports and SMS reminders.</p>
  </div>
  <div class="hero-actions">
    <a class="btn btn--secondary" href="/members/import">Import CSV / Excel</a>
  </div>
</section>

<% if (locals.errors && locals.errors.length) { %>
<div class="error-summary" role="alert" aria-live="assertive">
  <h2>There were errors with your submission</h2>
  <ul>
    <% locals.errors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<section class="grid two">
  <div class="panel">
    <div class="section-head">
      <div>
        <h2>Member list</h2>
        <p><%= members.length %> records in the register.</p>
      </div>
    </div>
    <div aria-live="polite" aria-atomic="false">
      <div class="table-wrap">
        <table class="data-table" id="members-table">
          <thead><tr><th>Name</th><th>Phone</th><th>DOB</th><th>Status</th><th class="num">Opening arrears</th><th></th></tr></thead>
          <tbody>
            <% members.forEach(function(member) { %>
              <tr>
                <td><strong><%= member.name %></strong></td>
                <td><%= member.phone || '' %></td>
                <td><%= member.dob || '' %></td>
                <td><span class="badge <%= member.status === 'active' ? 'badge--success' : 'badge--soft' %>"><%= member.status %></span></td>
                <td class="num"><%= formatMoney(member.opening_arrears) %></td>
                <td><a class="btn btn--secondary btn--sm" href="/members/<%= member.id %>/edit">Edit</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="panel">
    <h2>Add member</h2>
    <form method="post" action="/members" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Member details <span class="required-legend">* Required</span></legend>

        <div class="form-group">
          <label for="member-name">Name *</label>
          <input id="member-name" name="name" required value="<%= (locals.values && locals.values.name) || '' %>">
        </div>

        <div class="form-group">
          <label for="member-phone">Phone</label>
          <input id="member-phone" name="phone" value="<%= (locals.values && locals.values.phone) || '' %>">
        </div>

        <div class="form-group">
          <label for="member-dob">Date of birth</label>
          <input id="member-dob" name="dob" type="date" value="<%= (locals.values && locals.values.dob) || '' %>">
        </div>

        <div class="form-group">
          <label for="member-status">Status</label>
          <select id="member-status" name="status">
            <option value="active" <%= (locals.values && locals.values.status === 'inactive') ? '' : 'selected' %>>Active</option>
            <option value="inactive" <%= (locals.values && locals.values.status === 'inactive') ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>

        <div class="form-group">
          <label for="member-arrears">Opening arrears</label>
          <input id="member-arrears" name="opening_arrears" type="number" step="0.01" value="<%= (locals.values && locals.values.opening_arrears) || '0' %>">
        </div>

        <div class="form-group">
          <label for="member-notes">Notes</label>
          <textarea id="member-notes" name="notes"><%= (locals.values && locals.values.notes) || '' %></textarea>
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Add member</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
