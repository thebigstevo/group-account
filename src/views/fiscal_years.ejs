<%- include('partials/header') %>
<% locals.title = 'Fiscal Years' %>

<section class="page-title">
  <div>
    <span class="eyebrow">Year management</span>
    <h1>Fiscal years</h1>
    <p>Move each year through active entry, independent audit, and permanent close without delaying the next accounting year.</p>
  </div>
</section>
<p class="context-help no-print">New to year setup? <a href="/help#year-end">Read the fiscal-year guide</a>.</p>

<% if (locals.setup || !locals.activeFiscalYear) { %>
  <div class="warning-box" role="alert">
    <strong>Select an active fiscal year before using Treasurio.</strong>
    Opening a new year below makes it active automatically. If an open year already exists, select “Make active”.
  </div>
<% } else { %>
  <div class="info-box"><strong>Active fiscal year: <%= activeFiscalYear.year %></strong> — member opening balances, dues, reports, and new transactions use this accounting period.</div>
<% } %>

<% if (locals.errors && locals.errors.length) { %>
<div class="error-summary" role="alert" aria-live="assertive">
  <h2>There were errors with your submission</h2>
  <ul>
    <% locals.errors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<section class="grid two">
  <div class="panel">
    <h2>Year status</h2>
    <% if (years.length === 0) { %>
      <p class="text-muted">No fiscal years created yet. Open one to get started.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Year</th><th>Status</th><th>Active</th><th>Opened</th><th>Closed</th><th>Notes</th></tr></thead>
          <tbody>
            <% years.forEach(function(fy) { %>
              <tr>
                <td><strong><%= fy.year %></strong></td>
                <td><span class="badge <%= fy.status === 'open' ? 'badge--success' : (fy.status === 'pending_audit' ? 'badge--warning' : 'badge--soft') %>"><%= fy.status.replace('_', ' ') %></span></td>
                <td>
                  <% if (fy.is_active) { %>
                    <span class="badge badge--success">Active</span>
                  <% } else if (fy.status === 'open') { %>
                    <form method="post" action="/fiscal-years/<%= fy.year %>/activate">
                      <%- include('partials/csrf') %>
                      <button class="btn btn--secondary btn--sm" type="submit">Make active</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
                <td><%= formatDate(fy.opened_at) %></td>
                <td><%= formatDate(fy.closed_at) %></td>
                <td><%= fy.notes || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <h2>Open a new year</h2>
    <p class="text-muted text-sm">
      This creates the year's accounting period, makes it active, and copies dues rules and payment splits from the previous year.
    </p>
    <form method="post" action="/fiscal-years/open" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Open year <span class="required-legend">* Required</span></legend>
        <div class="form-group">
          <label for="open-year">Year *</label>
          <input id="open-year" name="year" type="number" value="<%= (locals.values && locals.values.year) || currentYear %>" required>
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Open year</button>
    </form>

    <% const openYears = years.filter(function(y) { return y.status === 'open' && y.is_active; }); %>
    <% if (openYears.length > 0) { %>
      <h2 style="margin-top: var(--space-6);">Submit year for audit</h2>
      <p class="text-muted text-sm">Use this when routine entries are complete, even if the trustees cannot audit immediately.</p>
      <ul class="text-muted text-sm" style="margin: 0 0 var(--space-3) var(--space-4); padding: 0;">
        <li>Locks routine entries and reversals in the submitted year</li>
        <li>Creates provisional opening arrears for the next year</li>
        <li>Allows the next year to be opened while audit work continues</li>
      </ul>
      <div class="warning-box">
        <strong>Check the books first.</strong> Corrections after submission must use the controlled audit-adjustment workflow and independent approval.
      </div>
      <form method="post" action="/fiscal-years/pending-audit" class="stack" data-validate>
        <%- include('partials/csrf') %>
        <fieldset class="fieldset">
          <legend>Submit for audit</legend>
          <div class="form-group">
            <label for="audit-year-submit">Year *</label>
            <select id="audit-year-submit" name="year" required>
              <% openYears.forEach(function(fy) { %>
                <option value="<%= fy.year %>"><%= fy.year %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="audit-submit-notes">Notes (optional)</label>
            <input id="audit-submit-notes" name="notes" maxlength="1000" placeholder="Year-end preparation notes">
          </div>
        </fieldset>
        <button class="btn btn--primary" type="submit"
          data-modal-confirm
          data-modal-title="Submit Fiscal Year for Audit"
          data-modal-body="This will lock routine entries for this year and create provisional opening balances for the next year. Later corrections require independent approval.">Submit for audit</button>
      </form>
    <% } %>

    <% const pendingYears = years.filter(function(y) { return y.status === 'pending_audit'; }); %>
    <% if (pendingYears.length > 0) { %>
      <h2 style="margin-top: var(--space-6);">Permanently close audited year</h2>
      <p class="text-muted text-sm">Available only after the trustee audit is completed and every proposed adjustment has been decided.</p>
      <form method="post" action="/fiscal-years/close" class="stack" data-validate>
        <%- include('partials/csrf') %>
        <div class="form-group"><label for="close-year">Audited year *</label><select id="close-year" name="year" required><% pendingYears.forEach(function(fy) { %><option value="<%= fy.year %>"><%= fy.year %></option><% }) %></select></div>
        <div class="form-group"><label for="close-notes">Final close notes (optional)</label><input id="close-notes" name="notes" maxlength="1000" placeholder="Audit completed and approved"></div>
        <button class="btn btn--danger" type="submit" data-modal-confirm data-modal-title="Permanently Close Fiscal Year" data-modal-body="This permanently locks the audited year and finalises the next year's opening arrears. This cannot be undone.">Permanently close audited year</button>
      </form>
    <% } %>
  </div>
</section>

<section class="panel">
  <h2>How it works</h2>
  <div class="steps-grid">
    <div>
      <strong class="text-primary">1. Open year</strong>
      <p class="text-sm">Creates the period. Copies dues rules and payment splits from last year so you can adjust them.</p>
    </div>
    <div>
      <strong class="text-primary">2. Work through the year</strong>
      <p class="text-sm">Enter receipts, expenses, transfers. Reconcile accounts monthly. Run reports.</p>
    </div>
    <div>
      <strong class="text-primary">3. Submit and audit</strong>
      <p class="text-sm">Freeze routine entries, continue in the next year, let trustees audit, approve any corrections independently, then permanently close.</p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
