<%- include('partials/header') %>
<% locals.title = 'Fiscal Years' %>

<section class="page-title">
  <div>
    <span class="eyebrow">Year management</span>
    <h1>Fiscal years</h1>
    <p>Open a new year to begin recording transactions. Close a year to lock it and carry arrears forward.</p>
  </div>
</section>

<% if (locals.errors && locals.errors.length) { %>
<div class="error-summary" role="alert" aria-live="assertive">
  <h2>There were errors with your submission</h2>
  <ul>
    <% locals.errors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<section class="grid two">
  <div class="panel">
    <h2>Year status</h2>
    <% if (years.length === 0) { %>
      <p class="text-muted">No fiscal years created yet. Open one to get started.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Year</th><th>Status</th><th>Opened</th><th>Closed</th><th>Notes</th></tr></thead>
          <tbody>
            <% years.forEach(function(fy) { %>
              <tr>
                <td><strong><%= fy.year %></strong></td>
                <td><span class="badge <%= fy.status === 'open' ? 'badge--success' : 'badge--soft' %>"><%= fy.status %></span></td>
                <td><%= formatDate(fy.opened_at) %></td>
                <td><%= formatDate(fy.closed_at) %></td>
                <td><%= fy.notes || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <h2>Open a new year</h2>
    <p class="text-muted text-sm">
      This creates the year's accounting period. Dues rules and payment splits from the previous year are copied automatically.
    </p>
    <form method="post" action="/fiscal-years/open" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Open year <span class="required-legend">* Required</span></legend>
        <div class="form-group">
          <label for="open-year">Year *</label>
          <input id="open-year" name="year" type="number" value="<%= (locals.values && locals.values.year) || currentYear %>" required>
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Open year</button>
    </form>

    <% const openYears = years.filter(function(y) { return y.status === 'open'; }); %>
    <% if (openYears.length > 0) { %>
      <h2 style="margin-top: var(--space-6);">Close a year</h2>
      <p class="text-muted text-sm">
        Closing a year will:
      </p>
      <ul class="text-muted text-sm" style="margin: 0 0 var(--space-3) var(--space-4); padding: 0;">
        <li>Lock all transactions in that year (no new entries, no reversals)</li>
        <li>Calculate each member's outstanding balance</li>
        <li>Set that balance as their opening arrears for the next year</li>
      </ul>
      <div class="warning-box">
        <strong>This action cannot be undone.</strong> Make sure all transactions are entered and reconciled before closing.
      </div>
      <form method="post" action="/fiscal-years/close" class="stack" data-validate>
        <%- include('partials/csrf') %>
        <fieldset class="fieldset">
          <legend>Close year</legend>
          <div class="form-group">
            <label for="close-year">Year to close *</label>
            <select id="close-year" name="year" required>
              <% openYears.forEach(function(fy) { %>
                <option value="<%= fy.year %>"><%= fy.year %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="close-notes">Notes (optional)</label>
            <input id="close-notes" name="notes" placeholder="End of year close">
          </div>
        </fieldset>
        <button class="btn btn--danger" type="submit"
          data-modal-confirm
          data-modal-title="Close Fiscal Year"
          data-modal-body="Are you sure you want to permanently close this fiscal year? This will lock all transactions and carry forward arrears. This action cannot be undone.">Close year permanently</button>
      </form>
    <% } %>
  </div>
</section>

<section class="panel">
  <h2>How it works</h2>
  <div class="steps-grid">
    <div>
      <strong class="text-primary">1. Open year</strong>
      <p class="text-sm">Creates the period. Copies dues rules and payment splits from last year so you can adjust them.</p>
    </div>
    <div>
      <strong class="text-primary">2. Work through the year</strong>
      <p class="text-sm">Enter receipts, expenses, transfers. Reconcile accounts monthly. Run reports.</p>
    </div>
    <div>
      <strong class="text-primary">3. Close year</strong>
      <p class="text-sm">Locks the year. Each member's outstanding balance becomes their opening arrears for next year.</p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
