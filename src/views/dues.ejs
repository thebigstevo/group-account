<%- include('partials/header') %>
<% locals.title = 'Dues' %>

<% if (locals.errors && locals.errors.length) { %>
<div class="error-summary" role="alert" aria-live="assertive">
  <h2>There were errors with your submission</h2>
  <ul>
    <% locals.errors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<section class="grid two">
  <div class="panel">
    <h1>Dues rules</h1>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Year</th><th>Label</th><th>Age band</th><th class="num">Total Assessment (incl. welfare)</th><th class="num">Welfare portion</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% rules.forEach(function(rule) { %>
            <tr>
              <td><%= rule.year %></td>
              <td><%= rule.label %></td>
              <td><%= rule.min_age ?? '' %> - <%= rule.max_age ?? '' %></td>
              <td class="num"><%= formatMoney(rule.annual_assessment) %></td>
              <td class="num"><%= formatMoney(rule.welfare_portion) %></td>
              <td><span class="badge <%= rule.active ? 'badge--success' : 'badge--soft' %>"><%= rule.active ? 'Active' : 'Inactive' %></span></td>
              <td>
                <% if (canManage && Number(rule.year) === Number(year)) { %>
                  <form method="post" action="/dues/rules/<%= rule.id %>/delete" data-confirm="Delete this unused dues rule?">
                    <%- include('partials/csrf') %><button class="btn btn--danger btn--sm" type="submit">Delete</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <h2>Add annual rule</h2>
    <% if (canManage) { %>
    <form method="post" action="/dues/rules" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Rule details <span class="required-legend">* Required</span></legend>

        <div class="form-group">
          <label for="rule-year">Year *</label>
          <input id="rule-year" name="year" type="number" value="<%= year %>" readonly required>
        </div>

        <div class="form-group">
          <label for="rule-label">Label *</label>
          <input id="rule-label" name="label" placeholder="e.g. Members under 60" required value="<%= (locals.values && locals.values.label) || '' %>">
        </div>

        <div class="row">
          <div class="form-group">
            <label for="rule-min-age">Min age</label>
            <input id="rule-min-age" name="min_age" type="number" value="<%= (locals.values && locals.values.min_age) || '' %>">
          </div>
          <div class="form-group">
            <label for="rule-max-age">Max age</label>
            <input id="rule-max-age" name="max_age" type="number" value="<%= (locals.values && locals.values.max_age) || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label for="rule-assessment">Total assessment (incl. welfare) *</label>
          <input id="rule-assessment" name="annual_assessment" type="number" step="0.01" required value="<%= (locals.values && locals.values.annual_assessment) || '' %>">
        </div>

        <div class="form-group">
          <label for="rule-welfare">Welfare portion *</label>
          <input id="rule-welfare" name="welfare_portion" type="number" step="0.01" required value="<%= (locals.values && locals.values.welfare_portion) || '' %>">
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Add rule</button>
    </form>
    <% } else { %><p class="text-muted">Only an administrator or finance secretary can change dues rules.</p><% } %>
  </div>
</section>

<% if (canManage) { %>
<section class="panel">
  <h2>Edit active-year rules</h2>
  <p class="text-muted text-sm">Rules become locked once assessment payments are posted, preserving member balances and historical calculations.</p>
  <div class="grid two">
    <% rules.filter(function(rule) { return Number(rule.year) === Number(year); }).forEach(function(rule) { %>
      <form method="post" action="/dues/rules/<%= rule.id %>" class="stack compact-form" data-validate>
        <%- include('partials/csrf') %>
        <fieldset class="fieldset"><legend><%= rule.label %></legend>
          <div class="form-group"><label for="rule-label-<%= rule.id %>">Label</label><input id="rule-label-<%= rule.id %>" name="label" value="<%= rule.label %>" required></div>
          <div class="grid two"><div class="form-group"><label for="rule-min-<%= rule.id %>">Min age</label><input id="rule-min-<%= rule.id %>" name="min_age" type="number" value="<%= rule.min_age == null ? '' : rule.min_age %>"></div><div class="form-group"><label for="rule-max-<%= rule.id %>">Max age</label><input id="rule-max-<%= rule.id %>" name="max_age" type="number" value="<%= rule.max_age == null ? '' : rule.max_age %>"></div></div>
          <div class="grid two"><div class="form-group"><label for="rule-assessment-<%= rule.id %>">Total assessment (incl. welfare)</label><input id="rule-assessment-<%= rule.id %>" name="annual_assessment" type="number" step="0.01" value="<%= rule.annual_assessment %>" required></div><div class="form-group"><label for="rule-welfare-<%= rule.id %>">Welfare portion</label><input id="rule-welfare-<%= rule.id %>" name="welfare_portion" type="number" step="0.01" value="<%= rule.welfare_portion %>" required></div></div>
          <label class="check"><input name="active" type="checkbox" <%= rule.active ? 'checked' : '' %>> Active</label>
        </fieldset>
        <button class="btn btn--primary btn--sm" type="submit">Save rule</button>
      </form>
    <% }) %>
  </div>
</section>
<% } %>

<section class="grid two">
  <div class="panel">
    <h2>Member-specific dues</h2>
    <% if (!overrides || overrides.length === 0) { %>
    <div class="error-summary" role="alert" style="background:#fef3c7; border-color:#f59e0b; padding:1rem; border-radius:6px; margin-bottom:1rem;">
      <p><strong>Diagnostic:</strong> No overrides found in database (<code>member_dues</code> table returned 0 rows).</p>
      <p>If you just saved an override and see this message, the table may not exist or the insert silently failed. Check that the migration has been run (<code>npm run migrate</code>).</p>
      <p>Raw count from DB: <strong><%= locals.overrideCountRaw || 'N/A' %></strong></p>
    </div>
    <% } %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Year</th><th>Member</th><th class="num">Total Assessment (incl. welfare)</th><th class="num">Welfare portion</th><th>Reason</th><th></th></tr></thead>
        <tbody>
          <% overrides.forEach(function(row) { %>
            <tr>
              <td><%= row.year %></td>
              <td><%= row.name || '(member #' + row.member_id + ')' %></td>
              <td class="num"><%= formatMoney(row.assessment_due) %></td>
              <td class="num"><%= formatMoney(row.welfare_portion) %></td>
              <td><%= row.reason || '' %></td>
              <td><% if (canManage && Number(row.year) === Number(year)) { %><form method="post" action="/dues/overrides/<%= row.id %>/delete" data-confirm="Remove this override and use the annual rule for this member?"><%- include('partials/csrf') %><button class="btn btn--danger btn--sm" type="submit">Remove</button></form><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <h2>Override a member</h2>
    <% if (canManage) { %>
    <form method="post" action="/dues/overrides" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Override details <span class="required-legend">* Required</span></legend>

        <div class="form-group">
          <label for="override-member">Member *</label>
          <select id="override-member" name="member_id" required>
            <% members.forEach(function(member) { %><option value="<%= member.id %>" <%= (locals.values && locals.values.member_id == member.id) ? 'selected' : '' %>><%= member.name %></option><% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="override-year">Year *</label>
          <input id="override-year" name="year" type="number" value="<%= year %>" readonly required>
        </div>

        <div class="form-group">
          <label for="override-assessment">Total assessment (incl. welfare) *</label>
          <input id="override-assessment" name="assessment_due" type="number" step="0.01" required value="<%= (locals.values && locals.values.assessment_due) || '' %>">
        </div>

        <div class="form-group">
          <label for="override-welfare">Welfare portion *</label>
          <input id="override-welfare" name="welfare_portion" type="number" step="0.01" required value="<%= (locals.values && locals.values.welfare_portion) || '' %>">
        </div>

        <div class="form-group">
          <label for="override-reason">Reason</label>
          <input id="override-reason" name="reason" placeholder="Special exemption" value="<%= (locals.values && locals.values.reason) || '' %>">
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Save override</button>
    </form>
    <% } else { %><p class="text-muted">You have read-only access.</p><% } %>
  </div>
</section>

<section class="panel" style="text-align: right;">
  <a class="btn btn--secondary btn--sm" href="/export/arrears?year=<%= year %>">Export Arrears CSV</a>
</section>

<section class="panel">
  <h2>Effective dues for <%= year %></h2>
  <p class="text-muted text-sm">What each active member owes based on overrides or age-band rules.</p>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Member</th>
          <th class="num">Total assessment (incl. welfare)</th>
          <th class="num">Welfare portion</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        <% effectiveDues.forEach(function(row) { %>
          <tr>
            <td><%= row.name %></td>
            <td class="num"><%= formatMoney(row.assessment_due) %></td>
            <td class="num"><%= formatMoney(row.welfare_portion) %></td>
            <td><span class="badge <%= row.source === 'Override' ? 'badge--warning' : 'badge--soft' %>"><%= row.source %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
