<%- include('partials/header') %>
<section class="grid two">
  <div class="panel">
    <h1>Dues rules</h1>
    <table>
      <thead><tr><th>Year</th><th>Label</th><th>Age band</th><th class="num">Assessment</th><th class="num">Welfare</th></tr></thead>
      <tbody>
        <% rules.forEach((rule) => { %>
          <tr>
            <td><%= rule.year %></td>
            <td><%= rule.label %></td>
            <td><%= rule.min_age ?? '' %> - <%= rule.max_age ?? '' %></td>
            <td class="num"><%= formatMoney(rule.annual_assessment) %></td>
            <td class="num"><%= formatMoney(rule.welfare_portion) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="panel">
    <h2>Add annual rule</h2>
    <form method="post" action="/dues/rules" class="stack">
      <%- include('partials/csrf') %>
      <label>Year <input name="year" type="number" value="<%= year %>" required></label>
      <label>Label <input name="label" placeholder="Standard members" required></label>
      <div class="row">
        <label>Min age <input name="min_age" type="number"></label>
        <label>Max age <input name="max_age" type="number"></label>
      </div>
      <label>Annual assessment <input name="annual_assessment" type="number" step="0.01" required></label>
      <label>Welfare portion <input name="welfare_portion" type="number" step="0.01" required></label>
      <button type="submit">Add rule</button>
    </form>
  </div>
</section>

<section class="grid two">
  <div class="panel">
    <h2>Member-specific dues</h2>
    <table>
      <thead><tr><th>Year</th><th>Member</th><th class="num">Assessment</th><th class="num">Welfare</th><th>Reason</th></tr></thead>
      <tbody>
        <% overrides.forEach((row) => { %>
          <tr>
            <td><%= row.year %></td>
            <td><%= row.name %></td>
            <td class="num"><%= formatMoney(row.assessment_due) %></td>
            <td class="num"><%= formatMoney(row.welfare_portion) %></td>
            <td><%= row.reason || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="panel">
    <h2>Override a member</h2>
    <form method="post" action="/dues/overrides" class="stack">
      <%- include('partials/csrf') %>
      <label>Member
        <select name="member_id" required>
          <% members.forEach((member) => { %><option value="<%= member.id %>"><%= member.name %></option><% }) %>
        </select>
      </label>
      <label>Year <input name="year" type="number" value="<%= year %>" required></label>
      <label>Assessment due <input name="assessment_due" type="number" step="0.01" required></label>
      <label>Welfare portion <input name="welfare_portion" type="number" step="0.01" required></label>
      <label>Reason <input name="reason" placeholder="Special exemption"></label>
      <button type="submit">Save override</button>
    </form>
  </div>
</section>
<section style="text-align: right; padding: 20px;">
  <a href="/export/arrears?year=<%= year %>" style="background: #4CAF50; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none; font-size: 0.9em;">Export Arrears CSV</a>
</section>
<%- include('partials/footer') %>
