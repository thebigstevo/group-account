<%- include('partials/header') %>
<section class="panel">
  <h1>Audit log</h1>
  <table>
    <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
    <tbody>
      <% rows.forEach((row) => { %>
        <tr>
          <td><%= row.created_at %></td>
          <td><%= row.user_name || '' %></td>
          <td><%= row.action %></td>
          <td><%= row.entity %> #<%= row.entity_id || '' %></td>
          <td><%= row.details || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<section style="text-align: right; padding: 20px;">
  <a href="/export/audit-log?days=90" style="background: #4CAF50; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none; font-size: 0.9em;">Export Audit Log (90d) CSV</a>
</section>
<%- include('partials/footer') %>
