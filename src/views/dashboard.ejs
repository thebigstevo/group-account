<%- include('partials/header') %>
<% locals.title = 'Dashboard' %>


<% if (locals.error) { %>
<section class="panel">
  <div class="error-state" role="alert" aria-live="assertive">
    <h2>Unable to load financial data</h2>
    <p>Financial data is temporarily unavailable. Please try again later or contact your administrator if the problem persists.</p>
  </div>
</section>
<% } else { %>

<!-- Page heading -->
<section class="page-title">
  <div>
    <span class="eyebrow"><%= groupName %></span>
    <h1>Dashboard</h1>
    <p>Financial overview, work queue, and recent activity.</p>
  </div>
</section>

<!-- Quick-action buttons (between heading and metrics) -->
<section class="quick-actions">
  <a class="btn btn--primary" href="/transactions">Record Receipt</a>
  <a class="btn btn--primary" href="/transactions">Record Expense</a>
  <a class="btn btn--secondary" href="/reconciliation">Reconcile</a>
  <a class="btn btn--secondary" href="/reports">View Reports</a>
</section>

<!-- Metric cards: account balances, income, expenses, welfare liability, spendable -->
<section class="metric-grid">
  <% summary.balances.forEach((account) => { %>
  <div class="metric-card">
    <span class="metric-card__label"><%= account.name %> balance</span>
    <strong class="metric-card__value"><%= formatMoney(account.balance) %></strong>
  </div>
  <% }) %>
  <div class="metric-card">
    <span class="metric-card__label">Total income</span>
    <strong class="metric-card__value"><%= formatMoney(summary.income) %></strong>
  </div>
  <div class="metric-card">
    <span class="metric-card__label">Total expenses</span>
    <strong class="metric-card__value"><%= formatMoney(summary.expenses) %></strong>
  </div>
  <div class="metric-card metric-card--warning">
    <span class="metric-card__label">Welfare liability</span>
    <strong class="metric-card__value"><%= formatMoney(summary.welfareLiability) %></strong>
  </div>
  <div class="metric-card metric-card--success">
    <span class="metric-card__label">Spendable estimate</span>
    <strong class="metric-card__value"><%= formatMoney(summary.spendableBalance) %></strong>
  </div>
</section>

<!-- Two-column responsive grid: work queue + recent transactions -->
<section class="dashboard-grid">
  <!-- Work queue card list -->
  <div class="panel">
    <div class="section-head">
      <div>
        <h2>Work queue</h2>
        <p>Items needing attention.</p>
      </div>
    </div>
    <div class="work-queue">
      <a href="/transactions" class="work-queue__item">
        <strong class="work-queue__count"><%= unreconciledCount %></strong>
        <span class="work-queue__label">Uncleared transactions</span>
      </a>
      <a href="/reports" class="work-queue__item">
        <strong class="work-queue__count"><%= arrearsCount %></strong>
        <span class="work-queue__label">Members with arrears</span>
      </a>
      <a href="/members" class="work-queue__item">
        <strong class="work-queue__count"><%= memberCount %></strong>
        <span class="work-queue__label">Active members</span>
      </a>
      <a href="/reconciliation" class="work-queue__item">
        <strong class="work-queue__count"><%= lastReconciliation || 'None' %></strong>
        <span class="work-queue__label">Latest reconciliation</span>
      </a>
    </div>
  </div>

  <!-- Recent transactions (Data_Table limited to 10) -->
  <div class="panel">
    <div class="section-head">
      <div>
        <h2>Recent transactions</h2>
        <p>Latest posted activity.</p>
      </div>
      <a href="/transactions" class="btn btn--secondary">View all</a>
    </div>
    <% if (recent.length === 0) { %>
    <div class="empty-state">
      <p>No transactions have been recorded yet.</p>
      <a class="btn btn--primary" href="/transactions">Record your first transaction</a>
    </div>
    <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Member</th>
            <th>Account</th>
            <th>Category</th>
            <th class="num">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% recent.forEach((row) => { %>
          <tr>
            <td><%= row.tx_date %></td>
            <td><span class="badge"><%= row.tx_type.replace('_', ' ') %></span></td>
            <td><%= row.member_name || '' %></td>
            <td><%= row.account_name || '' %></td>
            <td><%= row.category %></td>
            <td class="num"><%= formatMoney(row.amount) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>

<% } %>
<%- include('partials/footer') %>
