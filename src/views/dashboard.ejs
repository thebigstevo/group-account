<%- include('partials/header') %>
<% locals.title = 'Dashboard'; %>
<div class="page-container">
  <section class="page-title">
    <div><span class="eyebrow"><%= groupName %></span><h1>Dashboard</h1><p>Financial position, priorities, and recent activity.</p></div>
    <% if (locals.activeFiscalYear) { %><div class="page-title__meta"><span class="badge badge--success">Fiscal year <%= activeFiscalYear.year %></span></div><% } %>
  </section>

  <% if (locals.error) { %><section class="panel"><div class="error-state" role="alert" aria-live="assertive"><h2>Unable to load financial data</h2><p>Financial data is temporarily unavailable. Refresh the page or contact an administrator.</p></div></section><% } else { %>
  <section class="quick-actions" aria-label="Primary actions">
    <% if (['admin','finance_secretary','treasurer'].includes(user.role)) { %><a class="btn btn--primary" href="/finance/income/new">Add Income</a><% } %>
    <% if (['admin','treasurer'].includes(user.role)) { %><a class="btn btn--primary" href="/finance/expenses/new">Add Expense</a><% } %>
    <% if (['admin','treasurer','auditor','viewer'].includes(user.role)) { %><a class="btn btn--secondary" href="/finance/reconciliation">Reconcile</a><% } %>
    <a class="btn btn--secondary" href="/finance/reports">Reports</a>
  </section>

  <section class="summary-strip" aria-label="Key financial metrics">
    <div class="summary-strip__item"><span class="summary-strip__label">Total available balance</span><strong class="summary-strip__value"><%= formatMoney(summary.totalCashPosition) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Income · <%= dashboardMonth.label %></span><strong class="summary-strip__value"><%= formatMoney(monthSummary.income) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Expenses · <%= dashboardMonth.label %></span><strong class="summary-strip__value"><%= formatMoney(monthSummary.expenses) %></strong></div>
    <div class="summary-strip__item"><span class="summary-strip__label">Members with overdue dues</span><strong class="summary-strip__value"><%= arrearsCount %></strong></div>
  </section>

  <section class="dashboard-layout">
    <div class="dashboard-stack">
      <div>
        <div class="dashboard-total"><span>Total available balance</span><strong><%= formatMoney(summary.totalCashPosition) %></strong></div>
        <div class="account-list" aria-label="Account balances">
          <% if (!summary.balances.length) { %><div class="empty-state"><p>No active accounts are configured.</p></div><% } %>
          <% summary.balances.forEach(function(account) { %><div class="account-row"><span class="account-row__name"><%= account.name %></span><strong class="account-row__value"><%= formatMoney(account.balance) %></strong></div><% }) %>
        </div>
      </div>

      <div class="dashboard-section">
        <div class="section-head"><div><h2>Recent activity</h2><p>Latest posted transactions.</p></div><a href="/finance">View finance</a></div>
        <% if (!recent.length) { %><div class="empty-state"><p>No transactions have been recorded yet.</p></div><% } else { %>
        <div class="table-wrap desktop-table"><table class="data-table"><thead><tr><th>Date</th><th>Category</th><th>Account</th><th>Status</th><th class="num">Amount</th></tr></thead><tbody><% recent.forEach(function(row) { %><tr><td><%= formatDate(row.tx_date) %></td><td><%= row.category %></td><td><%= row.account_name || '—' %></td><td><span class="badge status-badge <%= row.reconciled ? 'badge--success' : 'badge--warning' %>"><%= row.reconciled ? 'Reconciled' : 'Unreconciled' %></span></td><td class="num"><%= formatMoney(row.amount) %></td></tr><% }) %></tbody></table></div>
        <div class="mobile-list"><% recent.forEach(function(row) { %><article class="transaction-card"><div class="transaction-card__top"><strong><%= row.category %></strong><span class="transaction-card__amount"><%= formatMoney(row.amount) %></span></div><div class="transaction-card__meta"><span><%= formatDate(row.tx_date) %></span><span><%= row.account_name || 'No account' %></span><span class="badge status-badge <%= row.reconciled ? 'badge--success' : 'badge--warning' %>"><%= row.reconciled ? 'Reconciled' : 'Unreconciled' %></span></div></article><% }) %></div><% } %>
      </div>
    </div>

    <aside class="dashboard-stack">
      <div class="dashboard-section"><div class="section-head"><div><h2>Work requiring attention</h2><p>Priorities for this period.</p></div></div><div class="work-queue"><a href="/finance" class="work-queue__item"><strong class="work-queue__count"><%= unreconciledCount %></strong><span class="work-queue__label">Unreconciled items</span></a><a href="/reports" class="work-queue__item"><strong class="work-queue__count"><%= arrearsCount %></strong><span class="work-queue__label">Members with overdue dues</span></a><a href="/members" class="work-queue__item"><strong class="work-queue__count"><%= memberCount %></strong><span class="work-queue__label">Active members</span></a></div></div>
      <div class="dashboard-section"><div class="section-head"><div><h2>Reconciliation status</h2><p>Latest completed account check.</p></div></div><strong><%= lastReconciliation ? formatDate(lastReconciliation) : 'No reconciliation recorded' %></strong><div class="actions" style="margin-top:1rem"><% if (['admin','treasurer','auditor','viewer'].includes(user.role)) { %><a href="/finance/reconciliation">Review reconciliation</a><% } %></div></div>
    </aside>
  </section>
  <% } %>
</div>
<%- include('partials/footer') %>
