<%- include('partials/header') %>
<% const isIncome = kind === 'income'; locals.title = isIncome ? 'Income' : 'Expenses'; %>
<%
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const filterMonth = locals.selectedMonth || '';
  const filterCategory = locals.selectedCategory || '';
  const filterMember = locals.selectedMember || '';
  const filterCategories = locals.categories || [];
  const filterMembers = locals.members || [];
  const fyear = locals.fiscalYear || new Date().getFullYear();
%>
<div class="page-container">
  <section class="page-title">
    <div><span class="eyebrow">Finance · FY <%= fyear %></span><h1><%= isIncome ? 'Income' : 'Expenses' %></h1><p><%= isIncome ? 'Money received into commandery accounts.' : 'Money paid out from commandery accounts.' %></p></div>
    <% if ((isIncome && ['admin','finance_secretary','treasurer'].includes(user.role)) || (!isIncome && ['admin','treasurer'].includes(user.role))) { %><a class="btn btn--primary" href="<%= isIncome ? '/finance/income/new' : '/finance/expenses/new' %>"><%= isIncome ? 'Record Income' : 'Record Expense' %></a><% if (isIncome) { %><a class="btn btn--secondary" href="/finance/income/batch">Batch Entry</a><% } %><% } %>
  </section>
  <%- include('partials/finance-nav') %>

  <!-- Filters -->
  <section class="report-toolbar" style="margin-bottom:var(--space-4)">
    <form method="get" action="<%= isIncome ? '/finance/income' : '/finance/expenses' %>" class="report-toolbar__fields" style="grid-template-columns:repeat(4,minmax(120px,1fr))">
      <div class="form-group">
        <label for="filter-month">Month</label>
        <select id="filter-month" name="month">
          <option value="">All months</option>
          <% months.forEach(function(m, idx) { %>
          <option value="<%= idx + 1 %>"<%= filterMonth == String(idx + 1) ? ' selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="filter-category">Category</label>
        <select id="filter-category" name="category">
          <option value="">All categories</option>
          <% filterCategories.forEach(function(cat) { %>
          <option value="<%= cat %>"<%= filterCategory === cat ? ' selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="filter-member"><%= isIncome ? 'Payer' : 'Member' %></label>
        <select id="filter-member" name="member_id">
          <option value="">All</option>
          <% filterMembers.forEach(function(m) { %>
          <option value="<%= m.id %>"<%= filterMember == String(m.id) ? ' selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="align-self:end">
        <button class="btn btn--secondary" type="submit">Filter</button>
      </div>
    </form>
    <% if (filterMonth || filterCategory || filterMember) { %>
    <div class="report-toolbar__actions"><a class="btn btn--secondary btn--sm" href="<%= isIncome ? '/finance/income' : '/finance/expenses' %>">Clear filters</a></div>
    <% } %>
  </section>

  <section class="panel">
    <div class="table-toolbar"><div><h2><%= isIncome ? 'Income register' : 'Expense register' %></h2><p><%= transactions.length %> <%= filterMonth ? months[filterMonth - 1] + ' ' : '' %><%= filterCategory ? filterCategory + ' ' : '' %><%= isIncome ? 'income' : 'expense' %> entries<%= filterMonth || filterCategory ? ' (filtered)' : '' %>.</p></div><a class="btn btn--secondary btn--sm" href="/export/transactions">Export CSV</a></div>
    <% if (!transactions.length) { %><div class="empty-state"><h2>No <%= isIncome ? 'income' : 'expenses' %> found</h2><p><%= filterMonth || filterCategory ? 'No entries match the selected filters. Try a different month or category.' : 'Entries for this workflow will appear here.' %></p></div><% } else { %>
    <div class="table-wrap desktop-table"><table class="data-table" data-datatable><thead><tr><th data-sortable="date">Date</th><th>Reference</th><th><%= isIncome ? 'Payer or source' : 'Payee or detail' %></th><th>Category</th><th><%= isIncome ? 'Received into' : 'Paid from' %></th><th class="num" data-sortable="amount">Amount</th><th>Status</th><% if (!isIncome) { %><th>Evidence</th><% } %><th>Recorded by</th><th>Actions</th></tr></thead><tbody>
      <% transactions.forEach(function(row) { %><tr><td data-sort-value="<%= formatDate(row.tx_date) %>"><%= formatDate(row.tx_date) %></td><td><%= row.reference || '—' %></td><td><%= row.member_name || row.description || '—' %></td><td><%= row.category %></td><td><%= row.account_name || '—' %></td><td class="num" data-sort-value="<%= row.amount %>"><%= formatMoney(row.amount) %></td><td><span class="badge status-badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span></td><% if (!isIncome) { %><td>—</td><% } %><td><%= row.recorded_by || 'System' %></td><td><% if (row.status === 'posted' && ['admin','finance_secretary','treasurer'].includes(user.role)) { %><div class="icon-actions"><a class="btn-icon" href="/transactions/<%= row.id %>/edit" title="Edit"><svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg></a><form method="post" action="/transactions/<%= row.id %>/reverse" style="display:inline"><%- include('partials/csrf') %><button class="btn-icon btn-icon--danger" type="submit" title="Reverse" data-modal-confirm data-modal-title="Reverse transaction" data-modal-body="Reverse this transaction?"><svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></button></form></div><% } else { %>—<% } %></td></tr><% }) %>
    </tbody><tfoot><tr class="data-table__total-row"><td colspan="<%= isIncome ? 5 : 5 %>"><strong>Total<%= (filterMonth || filterCategory) ? ' (filtered)' : '' %></strong></td><td class="num"><strong><%= formatMoney(transactions.filter(r => r.status === 'posted').reduce((sum, r) => sum + Number(r.amount), 0)) %></strong></td><td colspan="<%= isIncome ? 3 : 4 %>"></td></tr></tfoot></table></div>
    <div class="mobile-list"><% transactions.forEach(function(row) { %><article class="transaction-card"><div class="transaction-card__top"><strong><%= row.category %></strong><span class="transaction-card__amount"><%= formatMoney(row.amount) %></span></div><div class="transaction-card__meta"><span><%= formatDate(row.tx_date) %></span><span><%= row.account_name || 'No account' %></span><span class="badge status-badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span></div><% if (row.member_name || row.description) { %><p><%= row.member_name || row.description %></p><% } %><% if (row.reference) { %><small>Reference: <%= row.reference %></small><% } %><% if (row.status === 'posted' && ['admin','finance_secretary','treasurer'].includes(user.role)) { %><div class="transaction-card__actions"><div class="icon-actions"><a class="btn-icon" href="/transactions/<%= row.id %>/edit" title="Edit"><svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg></a><form method="post" action="/transactions/<%= row.id %>/reverse" style="display:inline"><%- include('partials/csrf') %><button class="btn-icon btn-icon--danger" type="submit" title="Reverse" data-modal-confirm data-modal-title="Reverse transaction" data-modal-body="Reverse this transaction?"><svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></button></form></div></div><% } %></article><% }) %>
    <div class="mobile-list__total"><span>Total<%= (filterMonth || filterCategory) ? ' (filtered)' : '' %></span><strong><%= formatMoney(transactions.filter(r => r.status === 'posted').reduce((sum, r) => sum + Number(r.amount), 0)) %></strong></div></div>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
