<%- include('partials/header') %>
<% const isIncome = kind === 'income'; locals.title = isIncome ? 'Income' : 'Expenses'; %>
<div class="page-container">
  <section class="page-title">
    <div><span class="eyebrow">Finance</span><h1><%= isIncome ? 'Income' : 'Expenses' %></h1><p><%= isIncome ? 'Money received into commandery accounts.' : 'Money paid out from commandery accounts.' %></p></div>
    <% if ((isIncome && ['admin','finance_secretary','treasurer'].includes(user.role)) || (!isIncome && ['admin','treasurer'].includes(user.role))) { %><a class="btn btn--primary" href="<%= isIncome ? '/finance/income/new' : '/finance/expenses/new' %>"><%= isIncome ? 'Record Income' : 'Record Expense' %></a><% } %>
  </section>
  <%- include('partials/finance-nav') %>
  <section class="panel">
    <div class="table-toolbar"><div><h2><%= isIncome ? 'Income register' : 'Expense register' %></h2><p><%= transactions.length %> recent <%= isIncome ? 'income' : 'expense' %> entries.</p></div><a class="btn btn--secondary btn--sm" href="/export/transactions">Export CSV</a></div>
    <% if (!transactions.length) { %><div class="empty-state"><h2>No <%= isIncome ? 'income' : 'expenses' %> recorded</h2><p>Entries for this workflow will appear here.</p></div><% } else { %>
    <div class="table-wrap desktop-table"><table class="data-table" data-datatable><thead><tr><th data-sortable="date">Date</th><th>Reference</th><th><%= isIncome ? 'Payer or source' : 'Payee or detail' %></th><th>Category</th><th><%= isIncome ? 'Received into' : 'Paid from' %></th><th class="num" data-sortable="amount">Amount</th><th>Status</th><% if (!isIncome) { %><th>Evidence</th><% } %><th>Recorded by</th><th>Actions</th></tr></thead><tbody>
      <% transactions.forEach(function(row) { %><tr><td data-sort-value="<%= formatDate(row.tx_date) %>"><%= formatDate(row.tx_date) %></td><td><%= row.reference || '—' %></td><td><%= row.member_name || row.description || '—' %></td><td><%= row.category %></td><td><%= row.account_name || '—' %></td><td class="num" data-sort-value="<%= row.amount %>"><%= formatMoney(row.amount) %></td><td><span class="badge status-badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span></td><% if (!isIncome) { %><td><span class="badge status-badge badge--soft">Not tracked</span></td><% } %><td><%= row.recorded_by || 'System' %></td><td><% if (row.status === 'posted' && ['admin','finance_secretary','treasurer'].includes(user.role)) { %><form method="post" action="/transactions/<%= row.id %>/reverse"><%- include('partials/csrf') %><button class="btn btn--secondary btn--sm" type="submit" data-modal-confirm data-modal-title="Reverse transaction" data-modal-body="Reverse this transaction? The audit history will be retained.">Reverse</button></form><% } else { %>—<% } %></td></tr><% }) %>
    </tbody></table></div>
    <div class="mobile-list"><% transactions.forEach(function(row) { %><article class="transaction-card"><div class="transaction-card__top"><strong><%= row.category %></strong><span class="transaction-card__amount"><%= formatMoney(row.amount) %></span></div><div class="transaction-card__meta"><span><%= formatDate(row.tx_date) %></span><span><%= row.account_name || 'No account' %></span><span class="badge status-badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span></div><% if (row.member_name || row.description) { %><p><%= row.member_name || row.description %></p><% } %><% if (row.reference) { %><small>Reference: <%= row.reference %></small><% } %></article><% }) %></div>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
