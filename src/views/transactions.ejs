<%- include('partials/header') %>
<section class="page-title">
  <div>
    <span class="eyebrow">Daily entry</span>
    <h1>Transactions</h1>
    <p>Record receipts, expenses, welfare payouts, and transfers across Cash, Bank, and Mobile Money.</p>
  </div>
  <a class="button secondary" href="/export/transactions">Export CSV</a>
</section>

<section class="grid three">
  <div class="panel">
    <h2>Receive payment</h2>
    <form method="post" action="/transactions/receipt" class="stack">
      <%- include('partials/csrf') %>
      <label>Date <input name="tx_date" type="date" required></label>
      <label>Member
        <select name="member_id">
          <option value="">No member</option>
          <% members.forEach((member) => { %><option value="<%= member.id %>"><%= member.name %></option><% }) %>
        </select>
      </label>
      <label>Account
        <select name="account_id" required>
          <% accounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.name %></option><% }) %>
        </select>
      </label>
      <label>Category
        <select name="category">
          <% incomeCategories.forEach((category) => { %><option><%= category.name %></option><% }) %>
        </select>
      </label>
      <label>Amount received <input name="amount" type="number" step="0.01" required></label>
      <label>Welfare portion <input name="welfare_component" type="number" step="0.01" placeholder="Auto from Config"></label>
      <label>Description <input name="description" placeholder="Receipt note or reference"></label>
      <button type="submit">Save receipt</button>
    </form>
  </div>

  <div class="panel">
    <h2>Record expense</h2>
    <form method="post" action="/transactions/expense" class="stack">
      <%- include('partials/csrf') %>
      <label>Date <input name="tx_date" type="date" required></label>
      <label>Paid from
        <select name="account_id" required>
          <% accounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.name %></option><% }) %>
        </select>
      </label>
      <label>Category
        <select name="category">
          <% expenseCategories.forEach((category) => { %><option><%= category.name %></option><% }) %>
        </select>
      </label>
      <label>Amount <input name="amount" type="number" step="0.01" required></label>
      <label>Description <input name="description" placeholder="What was paid for"></label>
      <button type="submit">Save expense</button>
    </form>
  </div>

  <div class="panel">
    <h2>Transfer money</h2>
    <form method="post" action="/transactions/transfer" class="stack">
      <%- include('partials/csrf') %>
      <label>Date <input name="tx_date" type="date" required></label>
      <label>From
        <select name="account_id" required>
          <% accounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.name %></option><% }) %>
        </select>
      </label>
      <label>To
        <select name="to_account_id" required>
          <% accounts.forEach((account) => { %><option value="<%= account.id %>"><%= account.name %></option><% }) %>
        </select>
      </label>
      <label>Amount <input name="amount" type="number" step="0.01" required></label>
      <label>Description <input name="description" placeholder="Transfer reason"></label>
      <button type="submit">Save transfer</button>
    </form>
  </div>
</section>

<section class="panel">
  <div class="section-head">
    <div>
      <h2>Transaction history</h2>
      <p>Recent entries. Clear transactions as they appear on account checks.</p>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th><th>Type</th><th>Status</th><th>Member</th><th>Account</th><th>To</th><th>Category</th>
          <th class="num">Amount</th><th class="num">Welfare</th><th>Cleared</th><th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach((row) => { %>
          <tr class="<%= row.status === 'reversed' ? 'muted-row' : '' %>">
            <td><%= row.tx_date %></td>
            <td><span class="badge"><%= row.tx_type.replace('_', ' ') %></span></td>
            <td><span class="badge <%= row.status === 'reversed' ? 'danger' : 'success' %>"><%= row.status %></span></td>
            <td><%= row.member_name || '' %></td>
            <td><%= row.account_name || '' %></td>
            <td><%= row.to_account_name || '' %></td>
            <td><%= row.category %></td>
            <td class="num"><%= formatMoney(row.amount) %></td>
            <td class="num"><%= formatMoney(row.welfare_component) %></td>
            <td><span class="badge <%= row.reconciled ? 'success' : 'soft' %>"><%= row.reconciled ? 'Cleared' : 'Pending' %></span></td>
            <td>
              <% if (row.status === 'posted') { %>
                <div class="row-actions">
                  <form method="post" action="/transactions/<%= row.id %>/reconcile">
                    <%- include('partials/csrf') %>
                    <button class="small-button" type="submit"><%= row.reconciled ? 'Unclear' : 'Clear' %></button>
                  </form>
                  <% if (user && (user.role === 'admin' || user.role === 'finance_secretary' || user.role === 'treasurer')) { %>
                    <form method="post" action="/transactions/<%= row.id %>/reverse">
                      <%- include('partials/csrf') %>
                      <button class="small-button danger-button" type="submit">Reverse</button>
                    </form>
                  <% } %>
                </div>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
