<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Treasurio — Group & Club Financial Management">
  <title><%= typeof locals.title !== 'undefined' && locals.title ? locals.title + ' – Treasurio' : 'Treasurio' %></title>
  <link rel="stylesheet" href="/app.css?v=<%= locals.assetVersion || 'dev' %>">
</head>
<%
  const hasAuthenticatedUser = Boolean(locals.user && locals.user.id);
%>
<body class="<%= hasAuthenticatedUser ? 'app-page' : 'auth-page' %>">
  <!-- Skip navigation link (first focusable element) -->
  <a href="#main-content" class="skip-nav">Skip to content</a>

  <% if (hasAuthenticatedUser) { %>
  <!-- Mobile top bar (visible ≤768px) -->
  <%- include('topbar-mobile') %>

  <!-- Sidebar navigation (left panel on desktop, drawer on mobile) -->
  <%- include('sidebar') %>

  <header class="topbar-desktop">
    <button type="button" class="topbar-desktop__collapse" data-sidebar-collapse aria-label="Collapse sidebar" aria-pressed="false">‹</button>
    <span class="topbar-desktop__context"><%= locals.activeFiscalYear ? 'Fiscal year ' + locals.activeFiscalYear.year : groupName %></span>
    <div class="topbar-desktop__user">
      <span><%= locals.user.name %></span>
      <a href="/change-password">Account</a>
    </div>
  </header>
  <% } %>

  <!-- Main content area -->
  <main id="main-content" class="main-content<%= hasAuthenticatedUser ? '' : ' auth-main' %>" role="main">
