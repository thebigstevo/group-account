<%
  const financePath = locals.currentPath || '';
  const financeRole = locals.user ? locals.user.role : 'viewer';
  const financeLinks = [
    ['/finance', 'Overview', financePath === '/finance'],
    ['/finance/income', 'Income', financePath.startsWith('/finance/income')],
    ['/finance/expenses', 'Expenses', financePath.startsWith('/finance/expenses')],
    ['/finance/reconciliation', 'Reconciliation', financePath.startsWith('/finance/reconciliation')],
    ['/finance/accounts', 'Accounts', financePath.startsWith('/finance/accounts')],
    ['/budgets', 'Budget', financePath.startsWith('/budgets')],
    ['/finance/reports', 'Reports', financePath.startsWith('/finance/reports')]
  ];
%>
<nav class="finance-nav" aria-label="Finance sections">
  <% financeLinks.forEach(function(link) { %>
    <% if (link[0] !== '/finance/reconciliation' || ['admin','treasurer','auditor','viewer'].includes(financeRole)) { %>
      <a href="<%= link[0] %>" class="<%= link[2] ? 'active' : '' %>" <%- link[2] ? 'aria-current="page"' : '' %>><%= link[1] %></a>
    <% } %>
  <% }) %>
</nav>
