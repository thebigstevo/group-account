<%
  const navUser = locals.user || {};
  const navPath = locals.currentPath || '/';
  const navRole = navUser.role || 'viewer';
  const canRecordIncome = ['admin', 'finance_secretary', 'treasurer'].includes(navRole);
  const canRecordExpense = ['admin', 'treasurer'].includes(navRole);
  const canReconcile = ['admin', 'treasurer', 'auditor', 'viewer'].includes(navRole);
  const canConfigure = ['admin', 'finance_secretary', 'treasurer'].includes(navRole);
  const canViewDues = ['admin', 'finance_secretary', 'treasurer', 'auditor', 'viewer'].includes(navRole);
  const canManageFiscalYears = ['admin', 'finance_secretary', 'treasurer'].includes(navRole);
  const canUseSms = ['admin', 'secretary', 'treasurer'].includes(navRole);
  const showAdministration = navRole === 'admin' || canConfigure || canViewDues || canManageFiscalYears || canUseSms;

  function navActive(path) {
    if (path === '/') return navPath === '/';
    return navPath === path || navPath.startsWith(path + '/');
  }

  function navRoleLabel(role) {
    const labels = {
      admin: 'Administrator', president: 'President', first_vice_president: 'First Vice President',
      second_vice_president: 'Second Vice President', secretary: 'Secretary',
      finance_secretary: 'Finance Secretary', treasurer: 'Treasurer', commander: 'Commander',
      trustee: 'Trustee', executive: 'Executive', viewer: 'Viewer', auditor: 'Auditor'
    };
    return labels[role] || role;
  }
%>

<aside class="sidebar" id="app-navigation" aria-label="Application navigation" aria-hidden="false">
  <!-- Brand header -->
  <div class="sidebar__brand">
    <div class="sidebar__brand-inner">
      <span class="sidebar__logo" aria-hidden="true">T</span>
      <div>
        <span class="sidebar__product">Treasurio</span>
        <span class="sidebar__organisation"><%= locals.groupName || 'Group management' %></span>
      </div>
    </div>
    <button type="button" class="sidebar__close" data-sidebar-close aria-label="Close navigation">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- User identity (visible on mobile drawer) -->
  <div class="sidebar__identity">
    <div class="sidebar__avatar" aria-hidden="true"><%= (navUser.name || 'U').charAt(0).toUpperCase() %></div>
    <div class="sidebar__identity-text">
      <strong title="<%= navUser.name || '' %>"><%= navUser.name || 'Signed-in user' %></strong>
      <span><%= navRoleLabel(navRole) %></span>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="sidebar__nav" aria-label="Main navigation">
    <div class="sidebar__group">
      <div class="sidebar__group-title">Overview</div>
      <a href="/" class="sidebar__link<%= navActive('/') ? ' active' : '' %>" <%- navActive('/') ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
        <span>Dashboard</span>
      </a>
      <a href="/members" class="sidebar__link<%= navActive('/members') ? ' active' : '' %>" <%- navActive('/members') ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
        <span>Members</span>
      </a>
    </div>

    <div class="sidebar__group">
      <div class="sidebar__group-title">Finance</div>
      <a href="/finance" class="sidebar__link<%= navPath === '/finance' ? ' active' : '' %>" <%- navPath === '/finance' ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"/></svg>
        <span>Overview</span>
      </a>
      <a href="/finance/income" class="sidebar__link<%= navPath === '/finance/income' || navPath === '/finance/income/new' ? ' active' : '' %>" <%- navPath === '/finance/income' ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clip-rule="evenodd"/></svg>
        <span>Income</span>
      </a>
      <a href="/finance/expenses" class="sidebar__link<%= navPath === '/finance/expenses' || navPath === '/finance/expenses/new' ? ' active' : '' %>" <%- navPath === '/finance/expenses' ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v3.586L7.707 7.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 8.586V5z" clip-rule="evenodd" transform="rotate(180 10 10)"/></svg>
        <span>Expenses</span>
      </a>
      <% if (['admin','treasurer'].includes(user.role)) { %>
      <a href="/finance/transfers" class="sidebar__link<%= navActive('/finance/transfers') ? ' active' : '' %>" <%- navActive('/finance/transfers') ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4 6h9.586l-2.293-2.293a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L13.586 8H4a1 1 0 010-2zm12 8H6.414l2.293 2.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L6.414 12H16a1 1 0 010 2z"/></svg>
        <span>Transfers</span>
      </a>
      <% } %>
      <% if (canReconcile) { %>
      <a href="/finance/reconciliation" class="sidebar__link<%= navActive('/finance/reconciliation') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span>Reconciliation</span>
      </a>
      <% } %>
      <a href="/finance/accounts" class="sidebar__link<%= navActive('/finance/accounts') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z"/><path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z"/><path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z"/></svg>
        <span>Accounts</span>
      </a>
      <a href="/budgets" class="sidebar__link<%= navActive('/budgets') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 0l-2 2a1 1 0 101.414 1.414L8 10.414l1.293 1.293a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span>Annual budget</span>
      </a>
    </div>

    <div class="sidebar__group">
      <div class="sidebar__group-title">Reports</div>
      <a href="/finance/reports" class="sidebar__link<%= navActive('/finance/reports') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm2 10a1 1 0 10-2 0v3a1 1 0 102 0v-3zm2-3a1 1 0 011 1v5a1 1 0 11-2 0v-5a1 1 0 011-1zm4-1a1 1 0 10-2 0v7a1 1 0 102 0V8z" clip-rule="evenodd"/></svg>
        <span>Financial reports</span>
      </a>
      <a href="/download-reports" class="sidebar__link<%= navActive('/download-reports') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        <span>Downloads</span>
      </a>
      <% if (['admin', 'auditor', 'trustee', 'treasurer'].includes(navRole)) { %>
      <a href="/trustee-audit" class="sidebar__link<%= navActive('/trustee-audit') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/></svg>
        <span>Trustee audit</span>
      </a>
      <a href="/auto-audit" class="sidebar__link<%= navActive('/auto-audit') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        <span>Auto audit</span>
      </a>
      <% } %>
      <% if (['admin', 'auditor', 'trustee'].includes(navRole)) { %>
      <a href="/audit" class="sidebar__link<%= navActive('/audit') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
        <span>Audit trail</span>
      </a>
      <% } %>
    </div>

    <% if (['admin', 'secretary', 'president', 'trustee'].includes(navRole)) { %>
    <div class="sidebar__group">
      <div class="sidebar__group-title">Secretary</div>
      <a href="/secretary/meetings" class="sidebar__link<%= navActive('/secretary') ? ' active' : '' %>" <%- navActive('/secretary') ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
        <span>Events & Attendance</span>
      </a>
    </div>
    <% } %>

    <% if (showAdministration) { %>
    <div class="sidebar__group">
      <div class="sidebar__group-title">Administration</div>
      <% if (navRole === 'admin') { %>
      <a href="/organization" class="sidebar__link<%= navActive('/organization') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"/></svg>
        <span>Organization</span>
      </a>
      <% } %>
      <% if (canConfigure) { %>
      <a href="/config" class="sidebar__link<%= navActive('/config') && !navActive('/config/ranks') && !navActive('/config/positions') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
        <span>Settings</span>
      </a>
      <% } %>
      <% if (canViewDues) { %>
      <a href="/dues" class="sidebar__link<%= navActive('/dues') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
        <span>Dues & rules</span>
      </a>
      <% } %>
      <% if (canManageFiscalYears) { %>
      <a href="/fiscal-years" class="sidebar__link<%= navActive('/fiscal-years') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
        <span>Fiscal years</span>
      </a>
      <% } %>
      <% if (canUseSms) { %>
      <a href="/sms" class="sidebar__link<%= navActive('/sms') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"/><path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h1a2 2 0 002-2V9a2 2 0 00-2-2h-1z"/></svg>
        <span>SMS Messages</span>
      </a>
      <% } %>
      <% if (navRole === 'admin') { %>
      <a href="/users" class="sidebar__link<%= navActive('/users') ? ' active' : '' %>">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z" clip-rule="evenodd"/></svg>
        <span>Users</span>
      </a>
      <a href="/admin/backup" class="sidebar__link">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        <span>Download backup</span>
      </a>
      <% } %>
    </div>
    <% } %>
  </nav>

  <!-- Footer area -->
  <div class="sidebar__footer">
    <% if (locals.activeFiscalYear) { %>
    <div class="sidebar__fiscal-badge">
      <span class="sidebar__fiscal-dot"></span>
      FY <%= locals.activeFiscalYear.year %>
    </div>
    <% } %>
    <div class="sidebar__footer-actions">
      <a href="/help" class="sidebar__footer-link<%= navActive('/help') ? ' active' : '' %>" <%- navActive('/help') ? 'aria-current="page"' : '' %>>
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-4a3 3 0 00-2.83 2 1 1 0 101.886.667A1 1 0 1110 10a1 1 0 00-1 1v1a1 1 0 102 0v-.17A3.001 3.001 0 0010 6zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
        <span>Help &amp; Guide</span>
      </a>
      <a href="/change-password" class="sidebar__footer-link">
        <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
        <span>Account</span>
      </a>
      <form method="post" action="/logout" class="sidebar__signout-form">
        <%- include('csrf') %>
        <button type="submit" class="sidebar__footer-link sidebar__signout">
          <svg class="sidebar__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/></svg>
          <span>Sign out</span>
        </button>
      </form>
    </div>
  </div>
</aside>

<div class="sidebar__backdrop" id="sidebar-backdrop" data-sidebar-backdrop aria-hidden="true"></div>
