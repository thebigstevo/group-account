<%
  const navUser = locals.user || {};
  const navPath = locals.currentPath || '/';
  const navRole = navUser.role || 'viewer';
  const canRecordIncome = ['admin', 'finance_secretary', 'treasurer'].includes(navRole);
  const canRecordExpense = ['admin', 'treasurer'].includes(navRole);
  const canReconcile = ['admin', 'treasurer', 'auditor', 'viewer'].includes(navRole);
  const canConfigure = ['admin', 'finance_secretary', 'treasurer'].includes(navRole);

  function navActive(path) {
    if (path === '/') return navPath === '/';
    return navPath === path || navPath.startsWith(path + '/');
  }

  function navRoleLabel(role) {
    const labels = {
      admin: 'Administrator', president: 'President', first_vice_president: 'First Vice President',
      second_vice_president: 'Second Vice President', secretary: 'Secretary',
      finance_secretary: 'Finance Secretary', treasurer: 'Treasurer', commander: 'Commander',
      trustee: 'Trustee', executive: 'Executive', viewer: 'Viewer', auditor: 'Auditor'
    };
    return labels[role] || role;
  }
%>

<aside class="sidebar" id="app-navigation" aria-label="Application navigation" aria-hidden="false">
  <div class="sidebar__brand">
    <div>
      <span class="sidebar__product">Treasurio</span>
      <span class="sidebar__organisation"><%= locals.groupName || 'Group management' %></span>
    </div>
    <button type="button" class="sidebar__close" data-sidebar-close aria-label="Close navigation">×</button>
  </div>

  <div class="sidebar__identity">
    <strong title="<%= navUser.name || '' %>"><%= navUser.name || 'Signed-in user' %></strong>
    <span><%= navRoleLabel(navRole) %></span>
  </div>

  <nav class="sidebar__nav" aria-label="Main navigation">
    <div class="sidebar__group">
      <div class="sidebar__group-title">Overview</div>
      <a href="/" class="sidebar__link<%= navActive('/') ? ' active' : '' %>" <%- navActive('/') ? 'aria-current="page"' : '' %>>Dashboard</a>
      <a href="/members" class="sidebar__link<%= navActive('/members') ? ' active' : '' %>" <%- navActive('/members') ? 'aria-current="page"' : '' %>>Members</a>
    </div>

    <div class="sidebar__group">
      <div class="sidebar__group-title">Finance</div>
      <a href="/finance" class="sidebar__link<%= navPath === '/finance' ? ' active' : '' %>" <%- navPath === '/finance' ? 'aria-current="page"' : '' %>>Overview</a>
      <a href="/finance/income" class="sidebar__link<%= navPath === '/finance/income' ? ' active' : '' %>" <%- navPath === '/finance/income' ? 'aria-current="page"' : '' %>>Income</a>
      <% if (canRecordIncome) { %><a href="/finance/income/new" class="sidebar__link sidebar__link--nested<%= navPath === '/finance/income/new' ? ' active' : '' %>">Record income</a><% } %>
      <a href="/finance/expenses" class="sidebar__link<%= navPath === '/finance/expenses' ? ' active' : '' %>" <%- navPath === '/finance/expenses' ? 'aria-current="page"' : '' %>>Expenses</a>
      <% if (canRecordExpense) { %><a href="/finance/expenses/new" class="sidebar__link sidebar__link--nested<%= navPath === '/finance/expenses/new' ? ' active' : '' %>">Record expense</a><% } %>
      <% if (canReconcile) { %><a href="/finance/reconciliation" class="sidebar__link<%= navActive('/finance/reconciliation') ? ' active' : '' %>">Reconciliation</a><% } %>
      <a href="/finance/accounts" class="sidebar__link<%= navActive('/finance/accounts') ? ' active' : '' %>">Accounts</a>
      <a href="/budgets" class="sidebar__link<%= navActive('/budgets') ? ' active' : '' %>">Annual budget</a>
      <a href="/finance/reports" class="sidebar__link<%= navActive('/finance/reports') ? ' active' : '' %>">Reports</a>
    </div>

    <div class="sidebar__group">
      <div class="sidebar__group-title">Reporting</div>
      <a href="/download-reports" class="sidebar__link<%= navActive('/download-reports') ? ' active' : '' %>">Downloads</a>
      <% if (['admin', 'auditor', 'trustee', 'treasurer'].includes(navRole)) { %><a href="/trustee-audit" class="sidebar__link<%= navActive('/trustee-audit') ? ' active' : '' %>">Trustee audit</a><% } %>
      <% if (['admin', 'auditor', 'trustee'].includes(navRole)) { %><a href="/audit" class="sidebar__link<%= navActive('/audit') ? ' active' : '' %>">System audit trail</a><% } %>
    </div>

    <% if (canConfigure || navRole === 'admin') { %>
    <div class="sidebar__group">
      <div class="sidebar__group-title">Administration</div>
      <% if (canConfigure) { %>
        <a href="/config" class="sidebar__link<%= navActive('/config') ? ' active' : '' %>">Settings</a>
        <a href="/config/ranks" class="sidebar__link<%= navActive('/config/ranks') ? ' active' : '' %>">Ranks</a>
        <a href="/config/positions" class="sidebar__link<%= navActive('/config/positions') ? ' active' : '' %>">Positions</a>
        <a href="/dues" class="sidebar__link<%= navActive('/dues') ? ' active' : '' %>">Dues</a>
        <a href="/fiscal-years" class="sidebar__link<%= navActive('/fiscal-years') ? ' active' : '' %>">Fiscal years</a>
      <% } %>
      <% if (navRole === 'admin') { %><a href="/users" class="sidebar__link<%= navActive('/users') ? ' active' : '' %>">Users</a><% } %>
    </div>
    <% } %>
  </nav>

  <div class="sidebar__user">
    <% if (locals.activeFiscalYear) { %><span class="badge badge--success">FY <%= locals.activeFiscalYear.year %></span><% } %>
    <a href="/change-password" class="sidebar__account-link">Account</a>
    <form method="post" action="/logout" class="sidebar__signout-form">
      <%- include('csrf') %>
      <button type="submit" class="sidebar__signout">Sign out</button>
    </form>
  </div>
</aside>

<button type="button" class="sidebar__backdrop" id="sidebar-backdrop" data-sidebar-backdrop aria-label="Close navigation" tabindex="-1"></button>
