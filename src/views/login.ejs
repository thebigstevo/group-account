<%- include('partials/header') %>
<% locals.title = 'Sign In' %>

<section class="auth" aria-labelledby="sign-in-title">
  <header class="auth__header">
    <span class="auth__brand">Treasurio</span>
    <h1 id="sign-in-title">Welcome back</h1>
    <p>Sign in with your executive account to manage your group’s finances.</p>
  </header>

  <% if (locals.error) { %><div class="alert" role="alert"><%= error %></div><% } %>

  <form method="post" action="/login" class="stack" data-validate>
    <%- include('partials/csrf') %>
    <fieldset class="fieldset">
      <legend>Account details <span class="required-legend">* Required</span></legend>

      <div class="form-group">
        <label for="login-email">Email *</label>
        <input id="login-email" name="email" type="email" required autofocus value="<%= (locals.values && locals.values.email) || '' %>">
      </div>

      <div class="form-group">
        <label for="login-password">Password *</label>
        <input id="login-password" name="password" type="password" required>
      </div>
    </fieldset>
    <button class="btn btn--primary" type="submit">Sign in</button>
  </form>
</section>
<%- include('partials/footer') %>
