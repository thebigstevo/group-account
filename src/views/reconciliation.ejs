<%- include('partials/header') %>
<% locals.title = 'Reconciliation' %>

<% if (locals.errors && locals.errors.length) { %>
<div class="error-summary" role="alert" aria-live="assertive">
  <h2>There were errors with your submission</h2>
  <ul>
    <% locals.errors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<section class="grid two">
  <div class="panel">
    <h1>Reconciliation</h1>
    <form method="post" action="/reconciliation" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <fieldset class="fieldset">
        <legend>Reconciliation details <span class="required-legend">* Required</span></legend>

        <div class="form-group">
          <label for="recon-account">Account *</label>
          <select id="recon-account" name="account_id" required>
            <% balances.forEach(function(account) { %>
              <option value="<%= account.id %>" <%= (locals.values && locals.values.account_id == account.id) ? 'selected' : '' %>><%= account.name %> - system <%= formatMoney(account.balance) %></option>
            <% }) %>
          </select>
        </div>

        <div class="row">
          <div class="form-group">
            <label for="recon-start">Period start *</label>
            <input id="recon-start" name="period_start" type="date" required value="<%= (locals.values && locals.values.period_start) || '' %>">
          </div>
          <div class="form-group">
            <label for="recon-end">Period end *</label>
            <input id="recon-end" name="period_end" type="date" required value="<%= (locals.values && locals.values.period_end) || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label for="recon-balance">Statement or counted balance *</label>
          <input id="recon-balance" name="statement_balance" type="number" step="0.01" required value="<%= (locals.values && locals.values.statement_balance) || '' %>">
        </div>

        <div class="form-group">
          <label for="recon-notes">Notes</label>
          <textarea id="recon-notes" name="notes"><%= (locals.values && locals.values.notes) || '' %></textarea>
        </div>
      </fieldset>
      <button class="btn btn--primary" type="submit">Save reconciliation</button>
    </form>
  </div>
  <div class="panel">
    <h2>Current balances</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Account</th><th class="num">Balance</th></tr></thead>
        <tbody>
          <% balances.forEach(function(account) { %>
            <tr><td><%= account.name %></td><td class="num"><%= formatMoney(account.balance) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="panel">
  <div class="section-head">
    <div>
      <h2>Reconciliation history</h2>
    </div>
    <a class="btn btn--secondary btn--sm" href="/export/reconciliations">Export CSV</a>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Period</th><th>Account</th><th class="num">Statement</th><th class="num">System</th><th class="num">Difference</th><th>Notes</th></tr></thead>
      <tbody>
        <% reconciliations.forEach(function(row) { %>
          <tr>
            <td><%= row.period_start %> to <%= row.period_end %></td>
            <td><%= row.account_name %></td>
            <td class="num"><%= formatMoney(row.statement_balance) %></td>
            <td class="num"><%= formatMoney(row.system_balance) %></td>
            <td class="num"><%= formatMoney(row.difference) %></td>
            <td><%= row.notes || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
