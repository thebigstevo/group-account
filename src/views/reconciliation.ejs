<%- include('partials/header') %>
<section class="grid two">
  <div class="panel">
    <h1>Reconciliation</h1>
    <form method="post" action="/reconciliation" class="stack">
      <%- include('partials/csrf') %>
      <label>Account
        <select name="account_id" required>
          <% balances.forEach((account) => { %>
            <option value="<%= account.id %>"><%= account.name %> - system <%= formatMoney(account.balance) %></option>
          <% }) %>
        </select>
      </label>
      <div class="row">
        <label>Period start <input name="period_start" type="date" required></label>
        <label>Period end <input name="period_end" type="date" required></label>
      </div>
      <label>Statement or counted balance <input name="statement_balance" type="number" step="0.01" required></label>
      <label>Notes <textarea name="notes"></textarea></label>
      <button type="submit">Save reconciliation</button>
    </form>
  </div>
  <div class="panel">
    <h2>Current balances</h2>
    <table>
      <thead><tr><th>Account</th><th class="num">Balance</th></tr></thead>
      <tbody>
        <% balances.forEach((account) => { %>
          <tr><td><%= account.name %></td><td class="num"><%= formatMoney(account.balance) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <h2>Reconciliation history</h2>
  <table>
    <thead><tr><th>Period</th><th>Account</th><th class="num">Statement</th><th class="num">System</th><th class="num">Difference</th><th>Notes</th></tr></thead>
    <tbody>
      <% reconciliations.forEach((row) => { %>
        <tr>
          <td><%= row.period_start %> to <%= row.period_end %></td>
          <td><%= row.account_name %></td>
          <td class="num"><%= formatMoney(row.statement_balance) %></td>
          <td class="num"><%= formatMoney(row.system_balance) %></td>
          <td class="num"><%= formatMoney(row.difference) %></td>
          <td><%= row.notes || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<section style="text-align: right; padding: 20px;">
  <a href="/export/reconciliations" style="background: #4CAF50; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none; font-size: 0.9em;">Export Reconciliations CSV</a>
</section>
<%- include('partials/footer') %>
