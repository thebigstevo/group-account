<%- include('partials/header') %>
<% locals.title = 'Manage Positions' %>
<%
  var levelLabels = { local_commandery: 'Local Commandery', district_regiment: 'District / Regiment', grand_commandery: 'Grand Commandery', supreme_subordinate: 'Supreme Subordinate', supreme_commandery: 'Supreme Commandery' };
%>
<section class="page-title"><div><span class="eyebrow">Administration</span><h1>Manage Positions</h1><p>Define the executive positions available for selection when recording member position history.</p></div></section>

<section class="grid two">
  <div class="panel"><h2>Current Positions</h2>
    <% if (positions && positions.length) { %>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Title</th><th>Level</th><th>Order</th><th>Status</th><th></th></tr></thead><tbody>
      <% positions.forEach(function(pos) { %>
      <tr>
        <td><strong><%= pos.title %></strong></td>
        <td><%= levelLabels[pos.level] || pos.level %></td>
        <td><%= pos.sort_order %></td>
        <td><span class="badge <%= pos.active ? 'badge--success' : 'badge--soft' %>"><%= pos.active ? 'Active' : 'Inactive' %></span></td>
        <td>
          <form method="post" action="/config/positions/<%= pos.id %>" style="display:inline">
            <%- include('partials/csrf') %>
            <input type="hidden" name="title" value="<%= pos.title %>">
            <input type="hidden" name="level" value="<%= pos.level %>">
            <input type="hidden" name="sort_order" value="<%= pos.sort_order %>">
            <% if (pos.active) { %>
              <button class="btn btn--small btn--secondary" type="submit" name="active" value="">Deactivate</button>
            <% } else { %>
              <input type="hidden" name="active" value="on">
              <button class="btn btn--small btn--secondary" type="submit">Activate</button>
            <% } %>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody></table></div>
    <% } else { %>
    <p>No positions defined yet. Add one using the form.</p>
    <% } %>
  </div>

  <div class="panel"><h2>Add New Position</h2>
    <form method="post" action="/config/positions" class="stack" data-validate>
      <%- include('partials/csrf') %>
      <div class="form-group"><label for="pos-title">Position title *</label><input id="pos-title" name="title" required maxlength="100" placeholder="e.g. Eminent Commander"></div>
      <div class="form-group"><label for="pos-level">Level *</label><select id="pos-level" name="level" required>
        <option value="local_commandery">Local Commandery</option>
        <option value="district_regiment">District / Regiment</option>
        <option value="grand_commandery">Grand Commandery</option>
        <option value="supreme_subordinate">Supreme Subordinate</option>
        <option value="supreme_commandery">Supreme Commandery</option>
      </select></div>
      <div class="form-group"><label for="pos-sort">Display order</label><input id="pos-sort" name="sort_order" type="number" value="0" min="0"></div>
      <button class="btn btn--primary" type="submit">Add position</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
