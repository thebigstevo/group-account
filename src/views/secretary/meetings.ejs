<%- include('../partials/header') %>
<% locals.title = 'Meetings' %>

<div class="page-container">
  <section class="page-title">
    <div>
      <h1>Meetings</h1>
      <p>Manage meeting records, attendance, and generate monthly reports.</p>
    </div>
    <div class="hero-actions">
      <% if (['admin','secretary'].includes(user.role)) { %>
      <a class="btn btn--primary" href="/secretary/meetings/new">Create Meeting</a>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <% if (!meetings.length) { %>
    <div class="empty-state">
      <p>No meetings recorded yet. Create one to get started.</p>
    </div>
    <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Location</th>
            <th style="text-align:center">Present</th>
            <th style="text-align:center">Excused</th>
            <th style="text-align:center">Absent</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% meetings.forEach(function(m) { %>
          <tr>
            <td><a href="/secretary/meetings/<%= m.id %>"><%= formatDate(m.meeting_date) %></a></td>
            <td><span class="badge"><%= m.meeting_type %></span></td>
            <td><%= m.location || '—' %></td>
            <td style="text-align:center"><%= m.present_count %></td>
            <td style="text-align:center"><%= m.excuse_count %></td>
            <td style="text-align:center"><%= m.absent_count %></td>
            <td><span class="badge status-badge badge--<%= m.status === 'approved' ? 'success' : m.status === 'submitted' ? 'warning' : 'info' %>"><%= m.status %></span></td>
            <td>
              <a class="btn btn--secondary btn--sm" href="/secretary/meetings/<%= m.id %>/report" download>Report PDF</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
