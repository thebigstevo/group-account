<%- include('../partials/header') %>
<% locals.title = 'Meeting — ' + formatDate(meeting.meeting_date) %>

<div class="page-container">
  <section class="page-title">
    <div>
      <h1>Meeting: <%= formatDate(meeting.meeting_date) %></h1>
      <p><span class="badge"><%= meeting.meeting_type %></span> <%= meeting.location || '' %></p>
    </div>
    <div class="hero-actions">
      <% if (['admin','secretary'].includes(user.role)) { %>
      <a class="btn btn--secondary" href="/secretary/meetings/<%= meeting.id %>/edit">Edit / Minutes</a>
      <a class="btn btn--secondary" href="/secretary/meetings/<%= meeting.id %>/attendance">Mark Attendance</a>
      <% } %>
      <a class="btn btn--secondary" href="/secretary/meetings/<%= meeting.id %>/report" download style="color:var(--danger-base)">Monthly Report PDF</a>
      <a class="btn btn--secondary" href="/secretary/meetings/<%= meeting.id %>/minutes" download>Minutes PDF</a>
    </div>
  </section>

  <!-- Attendance Summary -->
  <section class="panel">
    <h2>Attendance</h2>
    <% 
      const present = attendance.filter(a => a.status === 'present');
      const excused = attendance.filter(a => a.status === 'excuse');
      const absent = attendance.filter(a => a.status === 'absent');
    %>
    <div class="form-grid" style="margin-bottom: var(--space-3);">
      <div><strong>Present:</strong> <%= present.length %></div>
      <div><strong>Excused:</strong> <%= excused.length %></div>
      <div><strong>Absent:</strong> <%= absent.length %></div>
    </div>
    <% if (present.length) { %>
    <p style="font-size: 0.875rem; color: var(--neutral-600);"><%= present.map(a => a.member_name).join(', ') %></p>
    <% } %>
  </section>

  <!-- Charitable Works -->
  <section class="panel">
    <h2>Charitable Works</h2>
    <% if (charitable.length) { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Beneficiary</th><th>Purpose</th><th class="num">Amount</th><th></th></tr></thead>
        <tbody>
          <% charitable.forEach(function(c) { %>
          <tr>
            <td><%= c.beneficiary %></td>
            <td><%= c.purpose %></td>
            <td class="num"><%= formatMoney(c.amount) %></td>
            <td>
              <% if (['admin','secretary'].includes(user.role)) { %>
              <form method="post" action="/secretary/meetings/charitable/<%= c.id %>/delete" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--secondary btn--sm" title="Remove">×</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="text-muted">No charitable works recorded for this meeting.</p>
    <% } %>

    <% if (['admin','secretary'].includes(user.role)) { %>
    <details style="margin-top: var(--space-3);">
      <summary class="btn btn--secondary btn--sm">Add Charitable Work</summary>
      <form method="post" action="/secretary/meetings/<%= meeting.id %>/charitable" style="margin-top: var(--space-2);">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid">
          <div class="form-group"><label for="cw-beneficiary">Beneficiary</label><input type="text" id="cw-beneficiary" name="beneficiary" required></div>
          <div class="form-group"><label for="cw-purpose">Purpose</label><input type="text" id="cw-purpose" name="purpose" required></div>
          <div class="form-group"><label for="cw-amount">Amount (GH¢)</label><input type="number" id="cw-amount" name="amount" step="0.01" min="0" required></div>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Save</button>
      </form>
    </details>
    <% } %>
  </section>

  <!-- Volunteer Hours -->
  <section class="panel">
    <h2>Volunteer Hours</h2>
    <% if (volunteer.length) { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Brothers</th><th>Time (hrs)</th><th>Total Hrs</th><th>Purpose</th><th></th></tr></thead>
        <tbody>
          <% volunteer.forEach(function(v) { %>
          <tr>
            <td><%= v.num_brothers %></td>
            <td><%= Number(v.time_spent).toFixed(1) %></td>
            <td><%= Number(v.total_hours).toFixed(1) %></td>
            <td><%= v.purpose %></td>
            <td>
              <% if (['admin','secretary'].includes(user.role)) { %>
              <form method="post" action="/secretary/meetings/volunteer/<%= v.id %>/delete" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--secondary btn--sm" title="Remove">×</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="text-muted">No volunteer hours recorded for this meeting.</p>
    <% } %>

    <% if (['admin','secretary'].includes(user.role)) { %>
    <details style="margin-top: var(--space-3);">
      <summary class="btn btn--secondary btn--sm">Add Volunteer Hours</summary>
      <form method="post" action="/secretary/meetings/<%= meeting.id %>/volunteer" style="margin-top: var(--space-2);">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid">
          <div class="form-group"><label for="vh-brothers">Number of Brothers</label><input type="number" id="vh-brothers" name="num_brothers" min="1" value="1" required></div>
          <div class="form-group"><label for="vh-time">Time Spent (hours)</label><input type="number" id="vh-time" name="time_spent" step="0.5" min="0.5" required></div>
          <div class="form-group"><label for="vh-purpose">Purpose</label><input type="text" id="vh-purpose" name="purpose" required></div>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Save</button>
      </form>
    </details>
    <% } %>
  </section>

  <!-- Minutes Preview -->
  <% if (meeting.matters_arising || meeting.agenda || meeting.correspondence) { %>
  <section class="panel">
    <h2>Minutes Summary</h2>
    <% if (meeting.start_time) { %><p><strong>Start:</strong> <%= meeting.start_time %> <% if (meeting.opening_prayer_by) { %>— Opening prayer by <%= meeting.opening_prayer_by %><% } %></p><% } %>
    <% if (meeting.correspondence) { %><h3>Correspondence</h3><p style="white-space:pre-wrap; font-size:0.875rem;"><%= meeting.correspondence %></p><% } %>
    <% if (meeting.matters_arising) { %><h3>Matters Arising</h3><p style="white-space:pre-wrap; font-size:0.875rem;"><%= meeting.matters_arising %></p><% } %>
    <% if (meeting.agenda) { %><h3>Agenda / New Business</h3><p style="white-space:pre-wrap; font-size:0.875rem;"><%= meeting.agenda %></p><% } %>
    <% if (meeting.good_of_order) { %><h3>Good of the Order</h3><p style="white-space:pre-wrap; font-size:0.875rem;"><%= meeting.good_of_order %></p><% } %>
    <% if (meeting.end_time) { %><p><strong>End:</strong> <%= meeting.end_time %> <% if (meeting.mover) { %>— Moved by <%= meeting.mover %><% } %><% if (meeting.seconder) { %>, seconded by <%= meeting.seconder %><% } %></p><% } %>
  </section>
  <% } %>
</div>

<%- include('../partials/footer') %>
