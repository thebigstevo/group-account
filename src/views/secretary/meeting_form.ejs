<%- include('../partials/header') %>
<% locals.title = meeting ? 'Edit Meeting' : 'New Meeting' %>
<% const v = locals.values || meeting || {} %>
<% const meetingType = v.meeting_type || 'regular' %>

<div class="page-container">
  <section class="page-title">
    <div>
      <h1><%= meeting ? 'Edit Meeting' : 'Create Meeting' %></h1>
      <p><%= meeting ? 'Update meeting details and minutes.' : 'Record a new meeting.' %></p>
    </div>
  </section>

  <% if (errors && errors.length) { %>
  <div class="alert alert--error" role="alert">
    <ul><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul>
  </div>
  <% } %>

  <section class="panel">
    <form method="post" action="<%= meeting ? '/secretary/meetings/' + meeting.id : '/secretary/meetings' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid">
        <div class="form-group">
          <label for="meeting_date">Meeting Date</label>
          <input type="date" id="meeting_date" name="meeting_date" value="<%= v.meeting_date || '' %>" required>
        </div>
        <div class="form-group">
          <label for="meeting_type">Type</label>
          <select id="meeting_type" name="meeting_type" required>
            <% MEETING_TYPES.forEach(function(t) { %>
            <option value="<%= t %>" <%= meetingType === t ? 'selected' : '' %>><%= t === 'regular' ? 'Regular (Formal)' : t === 'special' ? 'Special (Informal)' : 'Board of Trustees' %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" value="<%= v.location || '' %>">
        </div>
      </div>

      <% if (meeting) { %>
      <hr style="margin: var(--space-4) 0;">

      <h2>1. Commencement</h2>
      <div class="form-grid">
        <div class="form-group">
          <label for="start_time">Start Time</label>
          <input type="time" id="start_time" name="start_time" value="<%= v.start_time || '' %>">
        </div>
        <div class="form-group">
          <label for="end_time">End Time</label>
          <input type="time" id="end_time" name="end_time" value="<%= v.end_time || '' %>">
        </div>
      </div>

      <% if (meetingType === 'regular' || meetingType === 'board') { %>
      <!-- Formal meeting sections -->

      <h2>3. Pro Tem Appointments</h2>
      <div class="form-group">
        <label for="pro_tem_appointments">Temporary role assignments for this meeting</label>
        <textarea id="pro_tem_appointments" name="pro_tem_appointments" rows="4" placeholder="A. 1st Vice President – Name&#10;B. 2nd Vice President – Name&#10;C. Secretary – Name"><%= v.pro_tem_appointments || '' %></textarea>
      </div>

      <h2>4. Opening Rituals</h2>
      <div class="form-group">
        <label for="opening_rituals">Notes on rituals observed</label>
        <textarea id="opening_rituals" name="opening_rituals" rows="2" placeholder="All opening rituals were observed."><%= v.opening_rituals || '' %></textarea>
      </div>

      <h2>6. Reading & Acceptance of Previous Minutes</h2>
      <div class="form-group">
        <label for="previous_minutes">Who delivered, who seconded, corrections</label>
        <textarea id="previous_minutes" name="previous_minutes" rows="2" placeholder="Delivered by acting secretary and seconded by Br. Name. No corrections."><%= v.previous_minutes || '' %></textarea>
      </div>

      <h2>7. Matters Arising & Agenda</h2>
      <div class="form-group">
        <label for="matters_arising">Discussion items with sub-headings (A. Topic, B. Topic...)</label>
        <textarea id="matters_arising" name="matters_arising" rows="8" placeholder="A. First Topic&#10;Discussion content...&#10;&#10;B. Second Topic&#10;Discussion content..."><%= v.matters_arising || '' %></textarea>
      </div>

      <h2>Good of the Order</h2>
      <div class="form-group">
        <label for="good_of_order">Member contributions and suggestions</label>
        <textarea id="good_of_order" name="good_of_order" rows="5" placeholder="i. Topic one&#10;Discussion...&#10;&#10;ii. Topic two&#10;Discussion..."><%= v.good_of_order || '' %></textarea>
      </div>

      <h2>Finance</h2>
      <div class="form-group">
        <label for="finance_summary">Collections and financial summary for this meeting</label>
        <textarea id="finance_summary" name="finance_summary" rows="4" placeholder="Assessment – 200ghs&#10;Levy – 50ghs&#10;Total – 250ghs"><%= v.finance_summary || '' %></textarea>
      </div>

      <h2>Correspondence</h2>
      <div class="form-group">
        <label for="correspondence">Letters and communications received or sent</label>
        <textarea id="correspondence" name="correspondence" rows="3"><%= v.correspondence || '' %></textarea>
      </div>

      <h2>Closing</h2>
      <div class="form-group">
        <label for="closing_notes">Closing rituals and time</label>
        <textarea id="closing_notes" name="closing_notes" rows="2" placeholder="All closing rituals were observed and meeting came to a close at 10:57am."><%= v.closing_notes || '' %></textarea>
      </div>

      <% } else { %>
      <!-- Informal/Special meeting — simple numbered discussion -->

      <h2>Discussion Notes</h2>
      <div class="form-group">
        <label for="discussion_notes">Numbered discussion items</label>
        <textarea id="discussion_notes" name="discussion_notes" rows="12" placeholder="1. First item discussed...&#10;2. Second item discussed...&#10;3. Third item discussed..."><%= v.discussion_notes || '' %></textarea>
      </div>

      <% } %>

      <div class="form-group">
        <label for="other_notes">Other Notes (optional)</label>
        <textarea id="other_notes" name="other_notes" rows="3"><%= v.other_notes || '' %></textarea>
      </div>
      <% } %>

      <div class="form-actions">
        <a class="btn btn--secondary" href="<%= meeting ? '/secretary/meetings/' + meeting.id : '/secretary/meetings' %>">Cancel</a>
        <button class="btn btn--primary" type="submit"><%= meeting ? 'Save Changes' : 'Create Meeting' %></button>
      </div>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
