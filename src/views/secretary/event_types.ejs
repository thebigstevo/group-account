<%- include('../partials/header') %>
<% locals.title = 'Event Types' %>

<div class="page-container">
  <section class="page-title">
    <div>
      <h1>Event Types</h1>
      <p>Manage the types of events that can be created.</p>
    </div>
  </section>

  <section class="panel narrow">
    <!-- Add new type -->
    <h2>Add Event Type</h2>
    <form method="post" action="/secretary/meetings/event-types" style="display:flex; gap: var(--space-3); align-items:end; flex-wrap:wrap; margin-bottom: var(--space-5);">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin:0; flex:1; min-width:200px;">
        <label for="et-name">Name</label>
        <input type="text" id="et-name" name="name" required placeholder="e.g. Drill Competition">
      </div>
      <div class="form-group" style="margin:0; width:80px;">
        <label for="et-order">Order</label>
        <input type="number" id="et-order" name="sort_order" value="0" min="0">
      </div>
      <button class="btn btn--primary btn--sm" type="submit">Add</button>
    </form>

    <!-- Existing types -->
    <h2>Current Types</h2>
    <% if (!types.length) { %>
    <p class="text-muted">No event types configured.</p>
    <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Name</th><th>Slug</th><th style="text-align:center">Order</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% types.forEach(function(t) { %>
          <tr>
            <td>
              <form method="post" action="/secretary/meetings/event-types/<%= t.id %>/edit" style="display:inline-flex; gap:var(--space-2); align-items:center;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="name" value="<%= t.name %>" style="width:160px; padding:var(--space-1) var(--space-2); font-size:0.8rem;">
                <input type="number" name="sort_order" value="<%= t.sort_order %>" style="width:50px; padding:var(--space-1); font-size:0.8rem;" min="0">
                <button type="submit" class="btn btn--secondary btn--sm">Save</button>
              </form>
            </td>
            <td style="font-family: var(--font-family-mono); font-size:0.75rem; color:var(--neutral-500);"><%= t.slug %></td>
            <td style="text-align:center"><%= t.sort_order %></td>
            <td><span class="badge <%= t.active ? 'badge--success' : 'badge--warning' %>"><%= t.active ? 'Active' : 'Inactive' %></span></td>
            <td>
              <% if (t.active) { %>
              <form method="post" action="/secretary/meetings/event-types/<%= t.id %>/delete" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--secondary btn--sm" title="Remove">×</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
