<%- include('partials/header') %>
<% locals.title = 'Downloads' %>

<div class="page-container">
  <section class="page-title">
    <div>
      <h1>Download Reports</h1>
      <p>Download formal financial reports as PDF or CSV for fiscal year <%= year %>.</p>
    </div>
  </section>

  <section class="panel">
    <table class="data-table">
      <thead>
        <tr><th>Report</th><th>Description</th><th style="text-align:center">CSV</th><th style="text-align:center">PDF</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Income &amp; Expenditure</strong></td>
          <td>Income less expenses, surplus or deficit</td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/income-expenditure?year=<%= year %>" download>CSV</a></td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/income-expenditure?year=<%= year %>&format=pdf" download style="color:var(--danger-base)">PDF</a></td>
        </tr>
        <tr>
          <td><strong>Receipts &amp; Payments</strong></td>
          <td>Cash movements per account</td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/receipts-payments?year=<%= year %>" download>CSV</a></td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/receipts-payments?year=<%= year %>&format=pdf" download style="color:var(--danger-base)">PDF</a></td>
        </tr>
        <tr>
          <td><strong>Welfare Fund</strong></td>
          <td>Collections, payouts, liability</td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/welfare-fund?year=<%= year %>" download>CSV</a></td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/welfare-fund?year=<%= year %>&format=pdf" download style="color:var(--danger-base)">PDF</a></td>
        </tr>
        <tr>
          <td><strong>Financial Position</strong></td>
          <td>Assets, liabilities, net assets</td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/financial-position?year=<%= year %>" download>CSV</a></td>
          <td style="text-align:center"><a class="btn btn--secondary btn--sm" href="/download/financial-position?year=<%= year %>&format=pdf" download style="color:var(--danger-base)">PDF</a></td>
        </tr>
      </tbody>
    </table>

    <h2 style="margin-top: var(--space-5);">Member Statement</h2>
    <form method="get" action="/download/member-statement" style="display:flex; align-items:end; gap: var(--space-3); flex-wrap:wrap;">
      <div class="form-group" style="margin:0; min-width:200px;">
        <label for="ms-member">Member</label>
        <select id="ms-member" name="member_id" required>
          <option value="">Select member</option>
          <% members.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
        </select>
      </div>
      <input type="hidden" name="year" value="<%= year %>">
      <button class="btn btn--secondary btn--sm" type="submit">CSV</button>
      <button class="btn btn--secondary btn--sm" type="submit" name="format" value="pdf" style="color:var(--danger-base)">PDF</button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
