<%- include('partials/header') %>
<% locals.title = member.name %>
<section class="page-title"><div><span class="eyebrow"><%= member.membership_number %></span><h1><%= member.name %></h1><p><%= member.commandery_name %> · <span class="badge <%= member.status === 'active' ? 'badge--success' : 'badge--soft' %>"><%= member.status %></span></p></div><% if (canEdit) { %><div class="hero-actions"><a class="btn btn--primary" href="/members/<%= member.id %>/edit">Edit profile</a></div><% } %></section>

<section class="grid two">
  <div class="panel"><h2>Member profile</h2><dl class="detail-list">
    <dt>Preferred name</dt><dd><%= member.preferred_name || '—' %></dd><dt>Primary phone</dt><dd><%= member.phone || '—' %></dd><dt>Secondary phone</dt><dd><%= member.secondary_phone || '—' %></dd><dt>Email</dt><dd><%= member.email || '—' %></dd><dt>Date of birth</dt><dd><%= formatDate(member.dob, '—') %></dd><dt>Parish</dt><dd><%= member.parish || '—' %></dd><dt>Occupation</dt><dd><%= member.occupation || '—' %></dd><dt>Date first admitted</dt><dd><%= formatDate(member.date_first_admitted, '—') %></dd><dt>Address</dt><dd><%= member.residential_address || '—' %></dd>
  </dl></div>
  <div class="panel"><h2>Status history</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Effective</th><th>Change</th><th>Reason</th></tr></thead><tbody>
    <% statusHistory.forEach(function(row) { %><tr><td><%= formatDate(row.effective_date) %></td><td><%= row.previous_status ? row.previous_status + ' → ' : '' %><strong><%= row.new_status %></strong></td><td><%= row.reason %><% if (row.supporting_reference) { %><br><small><%= row.supporting_reference %></small><% } %></td></tr><% }) %>
  </tbody></table></div>
  <% if (canEdit) { %><form method="post" action="/members/<%= member.id %>/status" class="stack" data-validate><%- include('partials/csrf') %><h3>Record status change</h3>
    <div class="form-group"><label for="status">New status *</label><select id="status" name="status" required><% statuses.filter(function(s) { return s !== member.status; }).forEach(function(status) { %><option value="<%= status %>"><%= status %></option><% }) %></select></div>
    <div class="form-group"><label for="effective-date">Effective date *</label><input id="effective-date" name="effective_date" type="date" required></div>
    <div class="form-group"><label for="status-reason">Reason *</label><textarea id="status-reason" name="reason" required></textarea></div>
    <div class="form-group"><label for="status-reference">Supporting reference</label><input id="status-reference" name="supporting_reference"></div><button class="btn btn--secondary" type="submit">Record status change</button>
  </form><% } %></div>
</section>

<% if (mayViewEmergency) { %><section class="grid two">
  <div class="panel"><h2>Emergency contacts</h2><% if (!emergencyContacts.length) { %><p>No emergency contact has been recorded.</p><% } %><% emergencyContacts.forEach(function(contact) { %><article class="card"><h3><%= contact.name %><% if (contact.is_primary) { %> <span class="badge">Primary</span><% } %></h3><p><%= contact.relationship %><br><strong><%= contact.primary_phone %></strong><% if (contact.secondary_phone) { %><br><%= contact.secondary_phone %><% } %></p><% if (contact.address) { %><p><%= contact.address %></p><% } %></article><% }) %></div>
  <% if (canEdit) { %><div class="panel"><h2>Add emergency contact</h2><form method="post" action="/members/<%= member.id %>/emergency-contacts" class="stack" data-validate><%- include('partials/csrf') %>
    <div class="form-group"><label for="contact-name">Name *</label><input id="contact-name" name="name" required></div><div class="form-group"><label for="contact-relationship">Relationship *</label><input id="contact-relationship" name="relationship" required></div><div class="form-group"><label for="contact-phone">Primary phone *</label><input id="contact-phone" name="primary_phone" inputmode="tel" required></div><div class="form-group"><label for="contact-secondary-phone">Secondary phone</label><input id="contact-secondary-phone" name="secondary_phone" inputmode="tel"></div><div class="form-group"><label for="contact-address">Address</label><textarea id="contact-address" name="address"></textarea></div><label><input type="checkbox" name="is_primary"> Primary emergency contact</label><button class="btn btn--primary" type="submit">Add contact</button>
  </form></div><% } %>
</section><% } %>
<%- include('partials/footer') %>
