<%- include('partials/header') %>
<% locals.title = 'Change Password' %>

<section class="panel narrow">
  <h1>Change password</h1>

  <% if (locals.errors && locals.errors.length) { %>
  <div class="error-summary" role="alert" aria-live="assertive">
    <h2>There were errors with your submission</h2>
    <ul>
      <% locals.errors.forEach(function(err) { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% if (locals.error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <% if (locals.success) { %><div class="alert alert--success" role="status"><%= success %></div><% } %>
  <% if (locals.flash && locals.flash.type === 'success') { %><div class="alert alert--success" role="status"><%= locals.flash.message %></div><% } %>

  <form method="post" action="/change-password" class="stack" data-validate>
    <%- include('partials/csrf') %>
    <fieldset class="fieldset">
      <legend>Password details <span class="required-legend">* Required</span></legend>

      <div class="form-group">
        <label for="cp-current">Current password *</label>
        <input id="cp-current" name="current_password" type="password" required>
      </div>

      <div class="form-group">
        <label for="cp-new">New password *</label>
        <input id="cp-new" name="new_password" type="password" required minlength="8">
      </div>

      <div class="form-group">
        <label for="cp-confirm">Confirm new password *</label>
        <input id="cp-confirm" name="confirm_password" type="password" required minlength="8">
      </div>
    </fieldset>
    <button class="btn btn--primary" type="submit">Change password</button>
  </form>
</section>
<%- include('partials/footer') %>
