<%- include('partials/header') %>
<% locals.title = 'Import Members' %>

<section class="panel">
  <h1>Import members</h1>
  <p class="text-muted">
    Upload a <strong>.csv</strong> or <strong>.xlsx</strong> file with member data.
    The importer matches columns by header name — column order does not matter.
  </p>

  <div class="info-box">
    <strong>Fiscal year <%= activeFiscalYear.year %></strong> is active. Opening balances in this upload will be treated as the starting member balances for this fiscal year.
  </div>

  <% if (locals.user && locals.user.role === 'admin') { %>
    <div class="hero-actions">
      <a class="btn btn--secondary" href="/export/members-cleanup">Download cleanup register</a>
    </div>
    <p class="text-muted text-sm">Edit only Membership Number, Name, Phone, DOB, Status, and Opening Balance, then upload the CSV below. Keep membership numbers unchanged so corrections target the right people.</p>
  <% } %>

  <div class="info-box">
    <strong>Expected columns (any order):</strong>
    <ul>
      <li><strong>Name</strong> — required (or "Full Name", "Member Name")</li>
      <li><strong>Membership Number</strong> — recommended for cleanup; identifies the exact existing member and is never changed by import</li>
      <li><strong>Phone</strong> — optional (or "Mobile", "Contact", "Telephone")</li>
      <li><strong>DOB</strong> — optional (or "Date of Birth", "Birthday") — formats: YYYY-MM-DD, DD/MM/YYYY, or Excel serial</li>
      <li><strong>Opening Arrears</strong> — optional (or "Arrears", "Balance", "Owing"). Positive means the member owes money; negative means the member has credit; zero means neither.</li>
      <li><strong>Status</strong> — optional, defaults to "active"</li>
    </ul>
  </div>

  <form method="post" action="/members/import" enctype="multipart/form-data" class="stack" data-validate>
    <%- include('partials/csrf') %>
    <fieldset class="fieldset">
      <legend>Upload file <span class="required-legend">* Required</span></legend>
      <div class="form-group">
        <label for="import-file">File (.csv or .xlsx) *</label>
        <input id="import-file" name="file" type="file" accept=".csv,.xlsx,.xls,.txt" required>
      </div>
    </fieldset>
    <button class="btn btn--primary" type="submit">Upload and import</button>
  </form>

  <% if (locals.result) { %>
    <div class="result-box <%= result.errors && result.errors.length ? 'result-box--error' : 'result-box--success' %>" role="alert" aria-live="polite">
      <strong><%= result.imported %> members imported/updated.</strong>
      <% if (result.skipped) { %><br><%= result.skipped %> rows skipped.<% } %>
      <% if (result.mapping) { %><br>Columns matched: <%= result.mapping.join(', ') %>.<% } %>
      <% if (result.balanceSummary) { %>
        <br>Balances applied: <%= result.balanceSummary.positive %> positive arrears,
        <%= result.balanceSummary.negative %> credits, and <%= result.balanceSummary.zero %> zero balances.
        Net opening balance: <%= formatMoney(result.balanceSummary.total) %>.
      <% } %>
      <% if (result.errors && result.errors.length) { %>
        <ul class="error-list">
          <% result.errors.slice(0, 10).forEach(function(err) { %><li><%= err %></li><% }) %>
          <% if (result.errors.length > 10) { %><li>...and <%= result.errors.length - 10 %> more</li><% } %>
        </ul>
      <% } %>
    </div>
  <% } %>

  <div class="template-section">
    <h2>CSV template</h2>
    <p class="text-muted text-sm">Copy this into a spreadsheet or text file and save as .csv:</p>
    <pre class="code-block">Name,Phone,Date of Birth,Opening Arrears
Kofi Mensah,0241234567,1975-03-12,500
Ama Owusu,0551234567,1990-08-25,0
Kwame Asante,0201234567,1965-11-03,1200</pre>
  </div>

  <div class="template-section">
    <h2>Import history</h2>
    <p class="text-muted text-sm">
      Imports listed here have row-level recovery data. Rollback restores members that were updated and removes members created by that import. It stops without changing anything if a member has since been edited or has later activity.
    </p>
    <% if (!locals.batches || !batches.length) { %>
      <div class="info-box">No tracked imports yet. Imports completed before this feature cannot be automatically rolled back because their previous values were not recorded. Uploading a corrected file will now apply the exact balance, including zero.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Fiscal year</th><th>File</th><th>Result</th><th>Balance signs</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% batches.forEach(function(batch) { %>
              <tr>
                <td><%= formatDateTime(batch.created_at) %><br><span class="text-muted text-sm"><%= batch.created_by_name || 'Unknown user' %></span></td>
                <td><%= batch.fiscal_year || 'Legacy' %></td>
                <td><strong><%= batch.filename %></strong></td>
                <td><%= batch.imported_count %> applied<br><span class="text-muted text-sm"><%= batch.skipped_count %> skipped</span></td>
                <td><%= batch.positive_count %> positive / <%= batch.negative_count %> credit / <%= batch.zero_count %> zero<br><span class="text-muted text-sm">Net <%= formatMoney(batch.total_opening_balance) %></span></td>
                <td><span class="badge <%= batch.status === 'completed' ? 'badge--success' : 'badge--soft' %>"><%= batch.status %></span></td>
                <td>
                  <% if (batch.status === 'completed' && locals.user && locals.user.role === 'admin') { %>
                    <form method="post" action="/members/imports/<%= batch.id %>/rollback" data-confirm="Roll back this import? This restores its previous member values and removes safe-to-delete newly imported members.">
                      <%- include('partials/csrf') %>
                      <button class="btn btn--danger btn--sm" type="submit">Roll back</button>
                    </form>
                  <% } else if (batch.status === 'reversed') { %>
                    <span class="text-muted text-sm"><%= batch.reversed_at ? formatDateTime(batch.reversed_at) : '' %></span>
                  <% } else { %>
                    <span class="text-muted text-sm">Admin only</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
