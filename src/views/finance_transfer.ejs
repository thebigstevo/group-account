<%- include('partials/header') %>
<% locals.title = 'Transfer Money'; %>
<% const activeYear = Number(activeFiscalYear.year); const today = new Date().toISOString().slice(0,10); const defaultDate = Number(today.slice(0,4)) === activeYear ? today : activeYear + '-01-01'; %>
<div class="page-container page-container--form">
  <section class="page-title"><div><span class="eyebrow">Finance · Transfers</span><h1>Transfer money</h1><p>Move money between commandery accounts without changing the total funds held.</p></div></section>
  <%- include('partials/finance-nav') %>

  <% if (locals.errors && locals.errors.length) { %><div class="error-summary" role="alert" aria-live="assertive"><h2>Check the information entered</h2><ul><% locals.errors.forEach(function(error) { %><li><%= error %></li><% }) %></ul></div><% } %>

  <section class="summary-strip" aria-label="Current account balances">
    <% accounts.forEach(function(account) { %><div class="summary-strip__item"><span class="summary-strip__label"><%= account.name %></span><strong class="summary-strip__value"><%= formatMoney(account.balance) %></strong></div><% }) %>
  </section>

  <section class="panel no-print">
    <div class="section-head"><div><h2>Transfer register report</h2><p>Choose a period to compare the system register with cashbooks, deposit slips, and bank statements.</p></div></div>
    <form method="get" action="/finance/transfers" class="filter-bar">
      <div class="form-group"><label for="transfer-report-start">From</label><input id="transfer-report-start" name="startDate" type="date" min="<%= activeYear %>-01-01" max="<%= activeYear %>-12-31" required value="<%= filters.startDate %>"></div>
      <div class="form-group"><label for="transfer-report-end">To</label><input id="transfer-report-end" name="endDate" type="date" min="<%= activeYear %>-01-01" max="<%= activeYear %>-12-31" required value="<%= filters.endDate %>"></div>
      <button class="btn btn--secondary" type="submit">View period</button>
      <a class="btn btn--primary" href="/export/transfers?startDate=<%= encodeURIComponent(filters.startDate) %>&endDate=<%= encodeURIComponent(filters.endDate) %>" download>Download CSV</a>
      <a class="btn btn--secondary" href="/export/transfers?startDate=<%= encodeURIComponent(filters.startDate) %>&endDate=<%= encodeURIComponent(filters.endDate) %>&format=pdf" download>Download PDF</a>
    </form>
  </section>

  <div class="form-layout">
    <form method="post" action="/transactions/transfer" class="form-card" data-validate>
      <%- include('partials/csrf') %>
      <section class="form-section" aria-labelledby="transfer-details-heading">
        <div class="form-section__heading"><h2 id="transfer-details-heading">Transfer details</h2><p>Required fields are marked with an asterisk.</p></div>
        <div class="field-grid">
          <div class="form-group"><label for="transfer-date">Date <span class="form-required" aria-hidden="true">*</span></label><input id="transfer-date" name="tx_date" type="date" min="<%= activeYear %>-01-01" max="<%= activeYear %>-12-31" required value="<%= (locals.values && locals.values.tx_date) || defaultDate %>"></div>
          <div class="form-group"><label for="transfer-amount">Amount <span class="form-required" aria-hidden="true">*</span></label><div class="amount-input"><span class="amount-input__currency"><%= groupCurrency %></span><input id="transfer-amount" name="amount" type="number" inputmode="decimal" min="0.01" step="0.01" required value="<%= (locals.values && locals.values.amount) || '' %>"></div></div>
          <div class="form-group"><label for="transfer-from">Move from <span class="form-required" aria-hidden="true">*</span></label><select id="transfer-from" name="account_id" required><option value="">Select source account</option><% accounts.forEach(function(account) { %><option value="<%= account.id %>" <%= locals.values && locals.values.account_id == account.id ? 'selected' : '' %>><%= account.name %> — <%= formatMoney(account.balance) %></option><% }) %></select></div>
          <div class="form-group"><label for="transfer-to">Move to <span class="form-required" aria-hidden="true">*</span></label><select id="transfer-to" name="to_account_id" required><option value="">Select destination account</option><% accounts.forEach(function(account) { %><option value="<%= account.id %>" <%= locals.values && locals.values.to_account_id == account.id ? 'selected' : '' %>><%= account.name %></option><% }) %></select></div>
          <div class="form-group"><label for="transfer-reference">Deposit slip or reference number</label><input id="transfer-reference" name="reference" maxlength="255" autocomplete="off" value="<%= (locals.values && locals.values.reference) || '' %>"></div>
          <div class="form-group field-grid__full"><label for="transfer-description">Description</label><textarea id="transfer-description" name="description" rows="4" maxlength="1000"><%= (locals.values && locals.values.description) || '' %></textarea></div>
        </div>
      </section>
      <div class="action-bar"><a class="btn btn--secondary" href="/finance">Cancel</a><button class="btn btn--primary" type="submit">Save Transfer</button></div>
    </form>
    <aside class="side-panel" aria-labelledby="transfer-guidance-heading"><h2 id="transfer-guidance-heading">What this does</h2><ul class="guidance-list"><li>Reduces the balance of the source account.</li><li>Increases the destination account by the same amount.</li><li>Does not record income or an expense.</li><li>Does not change Joint Welfare Held or total commandery funds.</li><li>The transfer is added to the audit trail automatically.</li></ul></aside>
  </div>

  <section class="panel">
    <div class="section-head"><div><h2>Transfer register</h2><p><%= filters.startDate %> to <%= filters.endDate %>. Reversed entries remain visible for audit but do not affect account balances.</p></div><strong><%= formatMoney(transfers.filter(function(row) { return row.status === 'posted'; }).reduce(function(sum, row) { return sum + Number(row.amount); }, 0)) %> posted</strong></div>
    <% if (!transfers.length) { %><div class="empty-state"><p>No transfers were recorded in the selected period.</p></div><% } else { %>
      <div class="table-wrap desktop-table"><table class="data-table"><thead><tr><th>Date</th><th>From</th><th>To</th><th>Reference</th><th>Description</th><th>Status</th><th class="num">Amount</th><th>Action</th></tr></thead><tbody><% transfers.forEach(function(row) { %><tr><td><%= formatDate(row.tx_date) %></td><td><%= row.from_account_name %></td><td><%= row.to_account_name %></td><td><%= row.reference || '—' %></td><td><%= row.description || '—' %></td><td><span class="badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span></td><td class="num"><%= formatMoney(row.amount) %></td><td><% if (row.status === 'posted') { %><form method="post" action="/transactions/<%= row.id %>/reverse"><%- include('partials/csrf') %><button class="btn btn--danger btn--sm" type="submit" data-modal-confirm data-modal-title="Reverse transfer" data-modal-body="Reverse this account transfer?" data-modal-prompt="reason" data-modal-prompt-label="Reason for reversal">Reverse</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div>
      <div class="mobile-list"><% transfers.forEach(function(row) { %><article class="transaction-card"><div class="transaction-card__top"><strong><%= row.from_account_name %> → <%= row.to_account_name %></strong><span class="transaction-card__amount"><%= formatMoney(row.amount) %></span></div><div class="transaction-card__meta"><span><%= formatDate(row.tx_date) %></span><span class="badge <%= row.status === 'posted' ? 'badge--success' : 'badge--danger' %>"><%= row.status === 'posted' ? 'Posted' : 'Reversed' %></span><% if (row.reference) { %><span><%= row.reference %></span><% } %></div><% if (row.description) { %><p><%= row.description %></p><% } %><% if (row.status === 'posted') { %><div class="transaction-card__actions"><form method="post" action="/transactions/<%= row.id %>/reverse"><%- include('partials/csrf') %><button class="btn btn--danger btn--sm" type="submit" data-modal-confirm data-modal-title="Reverse transfer" data-modal-body="Reverse this account transfer?" data-modal-prompt="reason" data-modal-prompt-label="Reason for reversal">Reverse</button></form></div><% } %></article><% }) %></div>
    <% } %>
  </section>
</div>
<script>
(function () {
  var from = document.getElementById('transfer-from');
  var to = document.getElementById('transfer-to');
  if (!from || !to) return;
  function preventSameAccount() {
    Array.prototype.forEach.call(to.options, function (option) {
      option.disabled = Boolean(from.value && option.value === from.value);
    });
    if (to.value === from.value) to.value = '';
  }
  from.addEventListener('change', preventSameAccount);
  preventSameAccount();
})();
</script>
<%- include('partials/footer') %>
