{
  "name": "treasurio",
  "version": "0.1.0",
  "private": true,
  "description": "Treasurio — Group & Club Financial Management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "import:workbook": "node src/importWorkbook.js",
