    "test:properties": "jest --testPathPattern=properties --detectOpenHandles"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "csv-stringify": "^6.4.6",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.18.1",
    "helmet": "^7.0.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "supertest": "^6.3.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.history/"
