# Treasurio — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection
PGHOST=postgres
PGPORT=5432
PGDATABASE=treasurio
PGUSER=treasurio
PGPASSWORD=changeme

# Application
APP_PORT=3100
DOMAIN=treasurio.example.com
SESSION_SECRET=change-this-to-a-long-random-string
N8N_API_TOKEN=change-this-n8n-token
NODE_ENV=production

# Branding
GROUP_NAME=My Group
GROUP_CURRENCY=GHS
